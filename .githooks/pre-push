#!/bin/bash
# Pre-push gate: mirrors the CI build-test job. Installed via `task hooks`.
# Skip with: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# A tag names a commit that already passed CI and this hook when its branch
# was pushed: a tags-only push (a release) skips the ~5 min rebuild.
tags_only=true
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/tags/*) ;;
        *) tags_only=false ;;
    esac
done
if $tags_only; then
    echo "hook: tags only — already built and tested; skipping"
    exit 0
fi

echo "hook: swift build…"
swift build

# Test only the targets the push changes (Sources/<T> -> Tests/<T>Tests);
# CI runs the whole suite. PRE_PUSH_FULL=1, a Package.swift change, or no
# origin/master base runs everything here too.
base=$(git merge-base origin/master HEAD 2>/dev/null || true)
changed=""
[ -n "$base" ] && changed=$(git diff --name-only "$base" HEAD)
if [ -n "${PRE_PUSH_FULL:-}" ] || [ -z "$base" ] || echo "$changed" | grep -q '^Package\.swift$'; then
    echo "hook: swift test…"
    swift test
    exit 0
fi

targets=$(echo "$changed" | sed -n 's|^Sources/\([^/]*\)/.*|\1Tests|p; s|^Tests/\([^/]*\)/.*|\1|p' |
    sort -u | while read -r t; do [ -d "Tests/$t" ] && echo "$t"; done)
if [ -z "$targets" ]; then
    echo "hook: no test target covers this push; skipping swift test"
    exit 0
fi
filter="^($(echo $targets | tr ' ' '|'))\."
echo "hook: swift test --filter '$filter'…"
swift test --filter "$filter"
