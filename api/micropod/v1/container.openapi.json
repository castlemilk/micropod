{
  "openapi": "3.1.0",
  "info": {
    "title": "micropod.v1 \u2014 container types",
    "version": "0.8.0",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {},
  "components": {
    "schemas": {
      "micropod.v1.Container": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "The container ID; `container` uses the user-assigned name as the ID."
          },
          "image": {
            "type": "string",
            "title": "image",
            "description": "Image reference the container was created from."
          },
          "state": {
            "type": "string",
            "title": "state",
            "description": "Lifecycle state: running, stopped, exited, created, ..."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "resources": {
            "title": "resources",
            "description": "Configured CPU/memory limits.",
            "$ref": "#/components/schemas/micropod.v1.ContainerResources"
          },
          "platform": {
            "type": "string",
            "title": "platform",
            "description": "Platform string, e.g. \"linux/arm64\"."
          },
          "publishedPorts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.PortMapping"
            },
            "title": "published_ports",
            "description": "Published host\u2192container port mappings."
          },
          "mounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.Mount"
            },
            "title": "mounts",
            "description": "Mounted volumes and binds."
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "networks",
            "description": "Names of networks the container is attached to."
          },
          "ipv4Address": {
            "type": "string",
            "title": "ipv4_address",
            "description": "Resolved IPv4 address on the container network, if running."
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "env",
            "description": "Environment variables as KEY=value pairs."
          },
          "labels": {
            "type": "object",
            "title": "labels",
            "additionalProperties": {
              "type": "string",
              "title": "value"
            },
            "description": "Metadata labels on the container."
          },
          "rosetta": {
            "type": "boolean",
            "title": "rosetta",
            "description": "Runs x86_64 binaries via Rosetta translation."
          },
          "readOnly": {
            "type": "boolean",
            "title": "read_only",
            "description": "Root filesystem is read-only."
          },
          "useInit": {
            "type": "boolean",
            "title": "use_init",
            "description": "An init process runs as PID 1 inside the container."
          },
          "ssh": {
            "type": "boolean",
            "title": "ssh",
            "description": "SSH access is enabled for the container."
          },
          "virtualization": {
            "type": "boolean",
            "title": "virtualization",
            "description": "Uses full virtualization rather than the container runtime path."
          },
          "runtimeHandler": {
            "type": "string",
            "title": "runtime_handler",
            "description": "OCI runtime handler in use, if any."
          },
          "exitCode": {
            "type": "string",
            "title": "exit_code",
            "description": "Exit code once the container has stopped."
          }
        },
        "title": "Container",
        "additionalProperties": false,
        "description": "Curated view of a container, mapped from `container list --format json`."
      },
      "micropod.v1.Container.LabelsEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "type": "string",
            "title": "value"
          }
        },
        "title": "LabelsEntry",
        "additionalProperties": false
      },
      "micropod.v1.ContainerResources": {
        "type": "object",
        "properties": {
          "cpus": {
            "type": "number",
            "title": "cpus",
            "format": "double",
            "description": "CPU limit in cores."
          },
          "memoryBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "memory_bytes",
            "format": "int64",
            "description": "Memory limit in bytes."
          }
        },
        "title": "ContainerResources",
        "additionalProperties": false
      },
      "micropod.v1.Mount": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "title": "type",
            "description": "Mount kind: \"volume\" or \"bind\"."
          },
          "source": {
            "type": "string",
            "title": "source",
            "description": "Volume name or host path."
          },
          "destination": {
            "type": "string",
            "title": "destination",
            "description": "Path inside the container."
          },
          "readOnly": {
            "type": "boolean",
            "title": "read_only",
            "description": "Mount is read-only."
          }
        },
        "title": "Mount",
        "additionalProperties": false,
        "description": "A volume or bind mount inside the container."
      },
      "micropod.v1.PortMapping": {
        "type": "object",
        "properties": {
          "hostPort": {
            "type": "integer",
            "title": "host_port",
            "maximum": 65535,
            "description": "Port on the host."
          },
          "containerPort": {
            "type": "integer",
            "title": "container_port",
            "maximum": 65535,
            "description": "Port inside the container."
          },
          "protocol": {
            "type": "string",
            "title": "protocol",
            "description": "\"tcp\" or \"udp\"."
          },
          "hostIp": {
            "type": "string",
            "title": "host_ip",
            "description": "Host interface IP to bind (empty = all interfaces)."
          }
        },
        "title": "PortMapping",
        "required": [
          "containerPort"
        ],
        "additionalProperties": false,
        "description": "A published port mapping between host and container."
      }
    }
  },
  "security": [],
  "servers": [
    {
      "url": "http://localhost:45454",
      "description": "Local Micropod daemon"
    }
  ],
  "externalDocs": {
    "description": "API explorer",
    "url": "https://castlemilk.github.io/micropod/api/"
  }
}
