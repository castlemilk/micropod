{
  "openapi": "3.1.0",
  "info": {
    "title": "micropod.v1 \u2014 image types",
    "version": "0.8.0",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
