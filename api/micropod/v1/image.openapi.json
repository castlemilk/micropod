    }
  },
  "paths": {},
  "components": {
    "schemas": {
      "micropod.v1.Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Image ID (content-addressed digest prefix)."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "names",
            "description": "All tags/references pointing at this image."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "digest": {
            "type": "string",
            "title": "digest",
            "description": "Content digest."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "Total unpacked size in bytes."
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ImageVariant"
            },
            "title": "variants",
            "description": "Per-platform variants of this image."
          }
        },
        "title": "Image",
        "additionalProperties": false,
        "description": "Curated view of a local image, mapped from `container image list --verbose`."
      },
      "micropod.v1.ImageVariant": {
        "type": "object",
        "properties": {
          "os": {
            "type": "string",
            "title": "os",
            "description": "Operating system, e.g. \"linux\"."
          },
          "architecture": {
            "type": "string",
            "title": "architecture",
            "description": "CPU architecture, e.g. \"arm64\"."
          },
          "variant": {
            "type": "string",
            "title": "variant",
            "description": "Architecture variant, e.g. \"v8\"."
          }
        },
        "title": "ImageVariant",
        "additionalProperties": false,
        "description": "One platform variant of a multi-arch image."
      }
    }
  },
  "security": [],
  "servers": [
    {
      "url": "http://localhost:45454",
      "description": "Local Micropod daemon"
    }
  ],
  "externalDocs": {
    "description": "API explorer",
    "url": "https://castlemilk.github.io/micropod/api/"
  }
}
