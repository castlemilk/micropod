{
  "openapi": "3.1.0",
  "info": {
    "title": "Micropod API \u00b7 K8sService",
    "description": "## micropod.v1.K8sService\n\nThe opt-in lightweight Kubernetes engine: a single micro-VM running\n `k3s server` (etcd + apiserver + kubelet + containerd), MetalLB on the\n vmnet subnet for real LoadBalancer IPs, and a host kubeconfig.",
    "version": "0.8.0",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {
