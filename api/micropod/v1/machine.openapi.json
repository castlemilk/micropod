              }
            },
            "application/grpc-web": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.StreamMachineLogsRequest"
              }
            },
            "application/grpc-web+proto": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.StreamMachineLogsRequest"
              }
            },
            "application/grpc-web+json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.StreamMachineLogsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
