{
  "openapi": "3.1.0",
  "info": {
    "title": "Micropod API \u00b7 MachineService",
    "description": "## micropod.v1.MachineService\n\nContainer machines: persistent Linux VMs (`container machine`) that\n keep a warm guest between runs \u2014 the keep-alive CI path. `container list`\n omits them and `container logs` doesn't know machine names, so they were\n invisible to container tooling. A running machine is backed by a per-boot\n container named `<machine>-<6 hex>` that `container stats` does report;\n metrics come from there, logs from the machine's own stdio/boot log.",
    "version": "0.11.1",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {
    "/api/micropod.v1.MachineService/GetMachineStats": {
      "post": {
        "tags": [
          "micropod.v1.MachineService"
        ],
        "summary": "GetMachineStats",
        "description": "Resource usage for running machines (all, or one by id), read from the\n backing container's cgroup \u2014 nothing runs inside the guest, and a\n stopped machine is never booted to be sampled. CPU % is a delta between\n samples; a machine with no recent baseline is sampled twice ~0.5 s\n apart so a one-shot call still reports a real figure.",
        "operationId": "micropod.v1.MachineService.GetMachineStats",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.GetMachineStatsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.MachineStatsSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.MachineService/ListMachines": {
      "post": {
        "tags": [
