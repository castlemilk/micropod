  },
  "components": {
    "schemas": {
      "connect-protocol-version": {
        "type": "number",
        "title": "Connect-Protocol-Version",
        "enum": [
          1
        ],
        "description": "Define the version of the Connect protocol",
        "const": 1
      },
      "connect-timeout-header": {
        "type": "number",
        "title": "Connect-Timeout-Ms",
        "description": "Define the timeout, in ms"
      },
      "connect.error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "not_found"
            ],
            "enum": [
              "canceled",
              "unknown",
              "invalid_argument",
              "deadline_exceeded",
              "not_found",
              "already_exists",
              "permission_denied",
              "resource_exhausted",
              "failed_precondition",
              "aborted",
              "out_of_range",
              "unimplemented",
              "internal",
              "unavailable",
              "data_loss",
              "unauthenticated"
            ],
            "description": "The status code, which should be an enum value of [google.rpc.Code][google.rpc.Code]."
          },
          "message": {
            "type": "string",
            "description": "A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the [google.rpc.Status.details][google.rpc.Status.details] field, or localized by the client."
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/connect.error_details.Any"
            },
            "description": "A list of messages that carry the error details. There is no limit on the number of messages."
          }
        },
        "title": "Connect Error",
        "additionalProperties": true,
        "description": "Error type returned by Connect: https://connectrpc.com/docs/go/errors/#http-representation"
      },
      "connect.error_details.Any": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URL that acts as a globally unique identifier for the type of the serialized message. For example: `type.googleapis.com/google.rpc.ErrorInfo`. This is used to determine the schema of the data in the `value` field and is the discriminator for the `debug` field."
          },
          "value": {
            "type": "string",
            "format": "binary",
            "description": "The Protobuf message, serialized as bytes and base64-encoded. The specific message type is identified by the `type` field."
          },
          "debug": {
            "oneOf": [
              {
                "type": "object",
                "title": "Any",
                "additionalProperties": true,
                "description": "Detailed error information."
              }
            ],
            "discriminator": {
              "propertyName": "type"
            },
            "title": "Debug",
            "description": "Deserialized error detail payload. The 'type' field indicates the schema. This field is for easier debugging and should not be relied upon for application logic."
          }
        },
        "additionalProperties": true,
        "description": "Contains an arbitrary serialized message along with a @type that describes the type of the serialized message, with an additional debug field for ConnectRPC error details."
      },
      "micropod.v1.CreateNetworkRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "minLength": 1,
            "description": "Network name."
          },
          "internal": {
            "type": "boolean",
            "title": "internal",
            "description": "Isolate the network from external traffic."
          },
          "subnet": {
            "type": [
              "string",
              "null"
            ],
            "title": "subnet",
            "description": "IPv4 CIDR for the network, e.g. \"192.168.100.0/24\"."
          },
          "subnetV6": {
            "type": [
              "string",
              "null"
            ],
            "title": "subnet_v6",
            "description": "IPv6 CIDR for the network."
          },
          "driver": {
            "type": [
              "string",
              "null"
            ],
            "title": "driver",
            "description": "Network driver/plugin to use."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "options",
            "description": "Driver options passed through to the network plugin."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "labels",
            "description": "Labels applied to the network (\"key=value\")."
          }
        },
        "title": "CreateNetworkRequest",
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "micropod.v1.DeleteNetworkRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "minLength": 1,
            "description": "Network name to remove."
          }
        },
        "title": "DeleteNetworkRequest",
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "micropod.v1.Empty": {
        "type": "object",
        "title": "Empty",
        "additionalProperties": false,
        "description": "The Micropod daemon API is grouped into per-domain services, one per file:\n\n   container.proto \u2014 ContainerService (lifecycle, logs, stats, exec)\n   image.proto     \u2014 ImageService (list, pull, delete)\n   volume.proto    \u2014 VolumeService (volumes + mount policy)\n   network.proto   \u2014 NetworkService\n   compose.proto   \u2014 Compose (up/down over a compose spec)\n   system.proto    \u2014 SystemService (snapshot, usage, app updates)\n\n Empty is shared by every service, so it lives here."
      },
      "micropod.v1.ListNetworksResponse": {
        "type": "object",
        "properties": {
          "networks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.Network"
            },
            "title": "networks",
            "description": "Every container network, in `container network list` order."
          }
        },
        "title": "ListNetworksResponse",
        "additionalProperties": false
      },
      "micropod.v1.Network": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Network ID (name)."
          },
          "plugin": {
            "type": "string",
            "title": "plugin",
            "description": "Network plugin backing this network, e.g. \"vmnet\"."
          },
          "mode": {
            "type": "string",
            "title": "mode",
            "description": "Network mode, e.g. \"nat\"."
          },
          "ipv4Gateway": {
            "type": "string",
            "title": "ipv4_gateway",
            "description": "IPv4 gateway address."
          },
          "ipv4Subnet": {
            "type": "string",
            "title": "ipv4_subnet",
            "description": "IPv4 CIDR of the network."
          },
          "ipv6Subnet": {
            "type": "string",
            "title": "ipv6_subnet",
            "description": "IPv6 CIDR of the network, if any."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "builtin": {
            "type": "boolean",
            "title": "builtin",
            "description": "True for runtime-managed networks that cannot be deleted."
          },
          "labels": {
            "type": "object",
            "title": "labels",
            "additionalProperties": {
              "type": "string",
              "title": "value"
            },
            "description": "Metadata labels on the network."
          }
        },
        "title": "Network",
        "additionalProperties": false,
        "description": "Curated network, mapped from `container network list`."
      },
      "micropod.v1.Network.LabelsEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "type": "string",
            "title": "value"
          }
        },
        "title": "LabelsEntry",
        "additionalProperties": false
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "micropod.v1.NetworkService",
      "description": "Container networks (vmnet-backed)."
    }
  ],
  "servers": [
    {
      "url": "http://localhost:45454",
      "description": "Local Micropod daemon"
    }
  ],
  "externalDocs": {
    "description": "API explorer",
    "url": "https://castlemilk.github.io/micropod/api/"
  }
}
