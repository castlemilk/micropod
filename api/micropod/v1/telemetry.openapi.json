{
  "openapi": "3.1.0",
  "info": {
    "title": "Micropod API \u00b7 TelemetryService",
    "description": "## micropod.v1.TelemetryService\n\nThe Linux CI worker's telemetry (the worker MICROPOD_CI_HOME names for the\n API process): one health verdict over its engine, hypervisor, kernel,\n caches and workloads, the guest's recent request issues, and its traces.\n Read live over the worker's sockets; the REST twins are GET /v1/ci/health\n and GET /v1/ci/traces. `unavailable` when no worker runs.",
    "version": "0.13.12",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {
    "/api/micropod.v1.TelemetryService/GetTelemetryHealth": {
      "post": {
        "tags": [
          "micropod.v1.TelemetryService"
        ],
        "summary": "GetTelemetryHealth",
        "operationId": "micropod.v1.TelemetryService.GetTelemetryHealth",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.TelemetryHealth"
                }
              }
            }
          }
        }
      }
    },
