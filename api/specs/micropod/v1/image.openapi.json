  "paths": {
    "/api/micropod.v1.ImageService/DeleteImage": {
      "post": {
        "tags": [
          "micropod.v1.ImageService"
        ],
        "summary": "DeleteImage",
        "description": "Remove an image. Images in use require force.",
        "operationId": "micropod.v1.ImageService.DeleteImage",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.DeleteImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.Empty"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.ImageService/ListImages": {
      "post": {
        "tags": [
          "micropod.v1.ImageService"
        ],
        "summary": "ListImages",
        "description": "List all local images.",
        "operationId": "micropod.v1.ImageService.ListImages",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.ListImagesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.ImageService/PullImage": {
