  "components": {
    "schemas": {
      "connect-protocol-version": {
        "type": "number",
        "title": "Connect-Protocol-Version",
        "enum": [
          1
        ],
        "description": "Define the version of the Connect protocol",
        "const": 1
      },
      "connect-timeout-header": {
        "type": "number",
        "title": "Connect-Timeout-Ms",
        "description": "Define the timeout, in ms"
      },
      "connect.error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "not_found"
            ],
            "enum": [
              "canceled",
              "unknown",
              "invalid_argument",
              "deadline_exceeded",
              "not_found",
              "already_exists",
              "permission_denied",
              "resource_exhausted",
              "failed_precondition",
              "aborted",
              "out_of_range",
              "unimplemented",
              "internal",
              "unavailable",
              "data_loss",
              "unauthenticated"
            ],
            "description": "The status code, which should be an enum value of [google.rpc.Code][google.rpc.Code]."
          },
          "message": {
            "type": "string",
            "description": "A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the [google.rpc.Status.details][google.rpc.Status.details] field, or localized by the client."
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/connect.error_details.Any"
            },
            "description": "A list of messages that carry the error details. There is no limit on the number of messages."
          }
        },
        "title": "Connect Error",
        "additionalProperties": true,
        "description": "Error type returned by Connect: https://connectrpc.com/docs/go/errors/#http-representation"
      },
      "connect.error_details.Any": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URL that acts as a globally unique identifier for the type of the serialized message. For example: `type.googleapis.com/google.rpc.ErrorInfo`. This is used to determine the schema of the data in the `value` field and is the discriminator for the `debug` field."
          },
          "value": {
            "type": "string",
            "format": "binary",
            "description": "The Protobuf message, serialized as bytes and base64-encoded. The specific message type is identified by the `type` field."
          },
          "debug": {
            "oneOf": [
              {
                "type": "object",
                "title": "Any",
                "additionalProperties": true,
                "description": "Detailed error information."
              }
            ],
            "discriminator": {
              "propertyName": "type"
            },
            "title": "Debug",
            "description": "Deserialized error detail payload. The 'type' field indicates the schema. This field is for easier debugging and should not be relied upon for application logic."
          }
        },
        "additionalProperties": true,
        "description": "Contains an arbitrary serialized message along with a @type that describes the type of the serialized message, with an additional debug field for ConnectRPC error details."
      },
      "micropod.v1.DeleteImageRequest": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "title": "reference",
            "minLength": 1,
            "description": "Image reference or digest to remove."
          },
          "force": {
            "type": "boolean",
            "title": "force",
            "description": "Remove even if containers reference the image."
          }
        },
        "title": "DeleteImageRequest",
        "required": [
          "reference"
        ],
        "additionalProperties": false
      },
      "micropod.v1.Empty": {
        "type": "object",
        "title": "Empty",
        "additionalProperties": false,
        "description": "The Micropod daemon API is grouped into per-domain services, one per file:\n\n   container.proto \u2014 ContainerService (lifecycle, logs, stats, exec)\n   image.proto     \u2014 ImageService (list, pull, delete)\n   volume.proto    \u2014 VolumeService (volumes + mount policy)\n   network.proto   \u2014 NetworkService\n   compose.proto   \u2014 Compose (up/down over a compose spec)\n   system.proto    \u2014 SystemService (snapshot, usage, app updates)\n\n Empty is shared by every service, so it lives here."
      },
      "micropod.v1.Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Image ID (content-addressed digest prefix)."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "names",
            "description": "All tags/references pointing at this image."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "digest": {
            "type": "string",
            "title": "digest",
            "description": "Content digest."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "Total unpacked size in bytes."
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ImageVariant"
            },
            "title": "variants",
            "description": "Per-platform variants of this image."
          }
        },
        "title": "Image",
        "additionalProperties": false,
        "description": "Curated view of a local image, mapped from `container image list --verbose`."
      },
      "micropod.v1.ImageVariant": {
        "type": "object",
        "properties": {
          "os": {
            "type": "string",
            "title": "os",
            "description": "Operating system, e.g. \"linux\"."
          },
          "architecture": {
            "type": "string",
            "title": "architecture",
            "description": "CPU architecture, e.g. \"arm64\"."
          },
          "variant": {
            "type": "string",
            "title": "variant",
            "description": "Architecture variant, e.g. \"v8\"."
          }
        },
        "title": "ImageVariant",
        "additionalProperties": false,
        "description": "One platform variant of a multi-arch image."
      },
      "micropod.v1.ListImagesResponse": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.Image"
            },
            "title": "images",
            "description": "Every local image, in `container image list` order."
          }
        },
        "title": "ListImagesResponse",
        "additionalProperties": false
      },
      "micropod.v1.ProgressLine": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "title": "line",
            "description": "Human-readable progress text from the registry pull."
          },
          "stage": {
            "type": [
              "integer",
              "null"
            ],
            "title": "stage",
            "format": "int32",
            "description": "Current stage index (1-based), when the pull reports staged progress."
          },
          "totalStages": {
            "type": [
              "integer",
              "null"
            ],
            "title": "total_stages",
            "format": "int32",
            "description": "Total number of stages, when known."
          }
        },
        "title": "ProgressLine",
        "additionalProperties": false,
        "description": "One pull-progress event (PullImage stream)."
      },
      "micropod.v1.PullImageRequest": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "title": "reference",
            "minLength": 1,
            "description": "Image reference to pull, e.g. \"alpine:3.20\" or a full registry path."
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "title": "platform",
            "description": "Platform to pull, e.g. \"linux/arm64\". Defaults to the host platform."
          }
        },
        "title": "PullImageRequest",
        "required": [
          "reference"
        ],
        "additionalProperties": false
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "micropod.v1.ImageService",
      "description": "Local image inventory and pulls."
    }
  ],
  "servers": [
    {
      "url": "http://localhost:45454",
      "description": "Local Micropod daemon"
    }
  ],
  "externalDocs": {
    "description": "API explorer",
    "url": "https://castlemilk.github.io/micropod/api/"
  }
}
