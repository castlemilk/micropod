        "properties": {
          "action": {
            "type": "string",
            "title": "action",
            "description": "noop, activated, rolled_back (success); failed_rollback and failed come\n back as errors, deferred as `failed_precondition`."
          },
          "fromVersion": {
            "type": [
              "string",
              "null"
            ],
            "title": "from_version"
          },
          "toVersion": {
            "type": [
              "string",
              "null"
            ],
            "title": "to_version"
          },
          "activeContainers": {
            "type": "integer",
            "title": "active_containers",
            "format": "int32",
            "description": "Workloads that held off a restart."
          },
          "detail": {
            "type": "string",
            "title": "detail"
          },
          "targetVersion": {
            "type": [
              "string",
              "null"
            ],
            "title": "target_version"
          },
          "switchoverMilliseconds": {
            "type": [
              "integer",
              "string",
              "null"
            ],
            "title": "switchover_milliseconds",
            "format": "int64"
          }
        },
        "title": "HVFUpdateResult",
        "additionalProperties": false
      },
      "micropod.v1.HVFUpdateStatus": {
        "type": "object",
        "properties": {
          "currentPath": {
            "type": [
              "string",
              "null"
            ],
            "title": "current_path",
            "description": "What a newly started supervisor boots (unset: the flat layout)."
          },
          "previousPath": {
            "type": [
              "string",
              "null"
            ],
            "title": "previous_path"
