{
  "openapi": "3.1.0",
  "info": {
    "title": "Micropod API \u00b7 RigService",
    "description": "## micropod.v1.RigService\n\nThe rootless rig: which execution mode new workloads use, the shared hvf\n machine's state and lifecycle, and its versioned payload (VMM, kernel,\n initrd, guest tools). The machine is the one MICROPOD_HVF_ROOT names for\n the API process. The REST routes under /v1/rig answer the same data.",
    "version": "0.13.12",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {
    "/api/micropod.v1.RigService/ApplyHVFUpdate": {
      "post": {
        "tags": [
          "micropod.v1.RigService"
        ],
        "summary": "ApplyHVFUpdate",
        "description": "Activate the staged payload: restart the machine onto it, probe it, and\n return to known-good if it fails. Deferred (`failed_precondition`, nothing\n stopped) while containers run or idleness cannot be confirmed, unless\n `force`.",
        "operationId": "micropod.v1.RigService.ApplyHVFUpdate",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.HVFUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.HVFUpdateResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.RigService/ControlMachine": {
      "post": {
        "tags": [
          "micropod.v1.RigService"
        ],
        "summary": "ControlMachine",
        "description": "Start (returns once the guest answers), stop (a stop on request: Ping and\n GetSystem then say stopped and nothing restarts it on demand) or restart\n the machine; replies with its status afterwards. Stop and restart are\n deferred (`failed_precondition`, nothing stopped) while containers run on\n a serving machine or its idleness cannot be confirmed, unless `force`.",
        "operationId": "micropod.v1.RigService.ControlMachine",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.ControlMachineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.HVFMachineStatus"
                }
              }
            }
          }
        }
      }
    },
