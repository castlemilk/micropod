{
  "openapi": "3.1.0",
  "info": {
    "title": "micropod.v1 \u2014 system types",
    "version": "0.8.0",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {},
  "components": {
    "schemas": {
      "micropod.v1.ContainerStats": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Container ID."
          },
          "cpuPercent": {
            "type": "number",
            "title": "cpu_percent",
            "format": "double",
            "description": "CPU usage as a percentage of one core."
          },
          "memoryUsedBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "memory_used_bytes",
            "format": "int64",
            "description": "Resident memory in bytes."
          },
          "memoryLimitBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "memory_limit_bytes",
            "format": "int64",
            "description": "Configured memory limit in bytes."
          },
          "networkRxBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "network_rx_bytes",
            "format": "int64",
            "description": "Bytes received over the container network."
          },
          "networkTxBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "network_tx_bytes",
            "format": "int64",
            "description": "Bytes transmitted over the container network."
          },
          "blockReadBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "block_read_bytes",
            "format": "int64",
            "description": "Bytes read from the block device."
          },
          "blockWriteBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "block_write_bytes",
            "format": "int64",
            "description": "Bytes written to the block device."
          },
          "pids": {
            "type": [
              "integer",
              "string"
            ],
            "title": "pids",
            "format": "int64",
            "description": "Number of processes inside the container."
          }
        },
        "title": "ContainerStats",
        "additionalProperties": false,
        "description": "Per-container resource counters within a StatsSnapshot."
      },
      "micropod.v1.DiskCategory": {
        "type": "object",
        "properties": {
          "total": {
            "type": [
              "integer",
              "string"
            ],
            "title": "total",
            "format": "int64",
            "description": "Total objects in the category."
          },
          "active": {
            "type": [
              "integer",
              "string"
            ],
            "title": "active",
            "format": "int64",
            "description": "Objects currently referenced by a running workload."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "On-disk size of the category in bytes."
          },
          "reclaimableBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "reclaimable_bytes",
            "format": "int64",
            "description": "Bytes freed if inactive objects were pruned."
          }
        },
        "title": "DiskCategory",
        "additionalProperties": false
      },
      "micropod.v1.DiskUsage": {
        "type": "object",
        "properties": {
          "containers": {
            "title": "containers",
            "description": "Disk usage attributed to containers.",
            "$ref": "#/components/schemas/micropod.v1.DiskCategory"
          },
          "images": {
            "title": "images",
            "description": "Disk usage attributed to images.",
            "$ref": "#/components/schemas/micropod.v1.DiskCategory"
          },
          "volumes": {
            "title": "volumes",
            "description": "Disk usage attributed to volumes.",
            "$ref": "#/components/schemas/micropod.v1.DiskCategory"
          },
          "totalReclaimableBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "total_reclaimable_bytes",
            "format": "int64",
            "description": "Bytes reclaimable by pruning across all categories."
          }
        },
        "title": "DiskUsage",
        "additionalProperties": false,
        "description": "Disk usage, mapped from `container system df`."
      },
      "micropod.v1.Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Image ID (content-addressed digest prefix)."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "names",
            "description": "All tags/references pointing at this image."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "digest": {
            "type": "string",
            "title": "digest",
            "description": "Content digest."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "Total unpacked size in bytes."
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ImageVariant"
            },
            "title": "variants",
            "description": "Per-platform variants of this image."
          }
        },
        "title": "Image",
        "additionalProperties": false,
        "description": "Curated view of a local image, mapped from `container image list --verbose`."
      },
      "micropod.v1.ImageVariant": {
        "type": "object",
        "properties": {
          "os": {
            "type": "string",
            "title": "os",
            "description": "Operating system, e.g. \"linux\"."
          },
          "architecture": {
            "type": "string",
            "title": "architecture",
            "description": "CPU architecture, e.g. \"arm64\"."
          },
          "variant": {
            "type": "string",
            "title": "variant",
            "description": "Architecture variant, e.g. \"v8\"."
          }
        },
        "title": "ImageVariant",
        "additionalProperties": false,
        "description": "One platform variant of a multi-arch image."
      },
      "micropod.v1.Network": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Network ID (name)."
          },
          "plugin": {
            "type": "string",
            "title": "plugin",
            "description": "Network plugin backing this network, e.g. \"vmnet\"."
          },
          "mode": {
            "type": "string",
            "title": "mode",
            "description": "Network mode, e.g. \"nat\"."
          },
          "ipv4Gateway": {
            "type": "string",
            "title": "ipv4_gateway",
            "description": "IPv4 gateway address."
          },
          "ipv4Subnet": {
            "type": "string",
            "title": "ipv4_subnet",
            "description": "IPv4 CIDR of the network."
          },
          "ipv6Subnet": {
            "type": "string",
            "title": "ipv6_subnet",
            "description": "IPv6 CIDR of the network, if any."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "builtin": {
            "type": "boolean",
            "title": "builtin",
            "description": "True for runtime-managed networks that cannot be deleted."
          },
          "labels": {
            "type": "object",
            "title": "labels",
            "additionalProperties": {
              "type": "string",
              "title": "value"
            },
            "description": "Metadata labels on the network."
          }
        },
        "title": "Network",
        "additionalProperties": false,
        "description": "Curated network, mapped from `container network list`."
      },
      "micropod.v1.Network.LabelsEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "type": "string",
            "title": "value"
          }
        },
        "title": "LabelsEntry",
        "additionalProperties": false
      },
      "micropod.v1.RegistryLogin": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "title": "server",
            "description": "Registry hostname, e.g. \"docker.io\"."
          },
          "username": {
            "type": "string",
            "title": "username",
            "description": "Account username stored for the registry."
          },
          "scheme": {
            "type": "string",
            "title": "scheme",
            "description": "Auth scheme in use, e.g. \"basic\" or \"oauth\"."
          }
        },
        "title": "RegistryLogin",
        "additionalProperties": false,
        "description": "A registry login, mapped from `container registry list`."
      },
      "micropod.v1.StatsSnapshot": {
        "type": "object",
        "properties": {
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ContainerStats"
            },
            "title": "containers",
            "description": "Per-container stats, one entry per running container."
          },
          "sampledAt": {
            "type": "string",
            "title": "sampled_at",
            "description": "ISO8601 timestamp the snapshot was taken."
          }
        },
        "title": "StatsSnapshot",
        "additionalProperties": false,
        "description": "Single snapshot of runtime resource usage for all running containers,\n mapped from `container stats --no-stream --format json`."
      },
      "micropod.v1.SystemStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "title": "status",
            "description": "\"running\" or \"stopped\"."
          },
          "appRoot": {
            "type": "string",
            "title": "app_root",
            "description": "Path to the installed Micropod.app bundle."
          },
          "installRoot": {
            "type": "string",
            "title": "install_root",
            "description": "Runtime install root (binaries, kernels, images)."
          },
          "apiServerVersion": {
            "type": "string",
            "title": "api_server_version",
            "description": "Version of the embedded API server."
          },
          "cliVersion": {
            "type": "string",
            "title": "cli_version",
            "description": "Version of the bundled `container` CLI."
          }
        },
        "title": "SystemStatus",
        "additionalProperties": false,
        "description": "Runtime health, mapped from `container system status`."
      },
      "micropod.v1.UpdateStatus": {
        "type": "object",
        "properties": {
          "state": {
            "title": "state",
            "description": "Updater lifecycle state.",
            "$ref": "#/components/schemas/micropod.v1.UpdateStatus.State"
          },
          "feedConfigured": {
            "type": "boolean",
            "title": "feed_configured",
            "description": "Whether a Sparkle feed URL is configured."
          },
          "currentVersion": {
            "type": "string",
            "title": "current_version",
            "description": "Currently running app version."
          },
          "availableVersion": {
            "type": "string",
            "title": "available_version",
            "description": "Version available on the feed, if an update was found."
          },
          "downloaded": {
            "type": "boolean",
            "title": "downloaded",
            "description": "True once an update has finished downloading."
          },
          "downloadedVersion": {
            "type": "string",
            "title": "downloaded_version",
            "description": "Version staged for install."
          },
          "readyToInstall": {
            "type": "boolean",
            "title": "ready_to_install",
            "description": "True when ApplyUpdate will succeed immediately."
          },
          "error": {
            "type": "string",
            "title": "error",
            "description": "Last updater error, when `state` is STATE_ERROR."
          },
          "checkedAt": {
            "type": "string",
            "title": "checked_at",
            "description": "ISO8601 time of the last completed check."
          }
        },
        "title": "UpdateStatus",
        "additionalProperties": false,
        "description": "Desktop-app updater status (Sparkle), proxied over the app control\n socket. Reported by CheckForUpdates, GetUpdateStatus, and ApplyUpdate."
      },
      "micropod.v1.UpdateStatus.State": {
        "type": "string",
        "title": "State",
        "enum": [
          "STATE_UNSPECIFIED",
          "STATE_UNAVAILABLE",
          "STATE_IDLE",
          "STATE_CHECKING",
          "STATE_UP_TO_DATE",
          "STATE_UPDATE_AVAILABLE",
          "STATE_INSTALLING",
          "STATE_ERROR"
        ],
        "description": "Updater lifecycle state."
      },
      "micropod.v1.UsageReport": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.UsageReport.ImageUsage"
            },
            "title": "images",
            "description": "Every local image with its referencing containers."
          },
          "volumes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.UsageReport.VolumeUsage"
            },
            "title": "volumes",
            "description": "Every local volume with its mounting containers."
          },
          "reclaimableImageBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "reclaimable_image_bytes",
            "format": "int64",
            "description": "Bytes reclaimable by pruning unreferenced images."
          },
          "reclaimableVolumeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "reclaimable_volume_bytes",
            "format": "int64",
            "description": "Bytes reclaimable by pruning unmounted volumes."
          },
          "stoppedContainerCount": {
            "type": "integer",
            "title": "stopped_container_count",
            "format": "int32",
            "description": "Number of stopped containers."
          }
        },
        "title": "UsageReport",
        "additionalProperties": false,
        "description": "What a cleanup would reclaim: every image and volume annotated with the\n containers that reference it."
      },
      "micropod.v1.UsageReport.ImageUsage": {
        "type": "object",
        "properties": {
          "image": {
            "title": "image",
            "description": "The image.",
            "$ref": "#/components/schemas/micropod.v1.Image"
          },
          "usedByContainerIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "used_by_container_ids",
            "description": "IDs of containers referencing this image."
          },
          "inUse": {
            "type": "boolean",
            "title": "in_use",
            "description": "True when at least one container references the image."
          }
        },
        "title": "ImageUsage",
        "additionalProperties": false,
        "description": "An image plus the containers that reference it."
      },
      "micropod.v1.UsageReport.VolumeUsage": {
        "type": "object",
        "properties": {
          "volume": {
            "title": "volume",
            "description": "The volume.",
            "$ref": "#/components/schemas/micropod.v1.Volume"
          },
          "usedByContainerIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "used_by_container_ids",
            "description": "IDs of containers mounting this volume."
          },
          "inUse": {
            "type": "boolean",
            "title": "in_use",
            "description": "True when at least one container mounts the volume."
          }
        },
        "title": "VolumeUsage",
        "additionalProperties": false,
        "description": "A volume plus the containers mounting it."
      },
      "micropod.v1.Volume": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Volume name (used as the ID)."
          },
          "driver": {
            "type": "string",
            "title": "driver",
            "description": "Volume driver, e.g. \"local\"."
          },
          "format": {
            "type": "string",
            "title": "format",
            "description": "Filesystem format, e.g. \"ext4\"."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "Volume size in bytes."
          },
          "source": {
            "type": "string",
            "title": "source",
            "description": "Backing source (name or host path)."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "labels": {
            "type": "object",
            "title": "labels",
            "additionalProperties": {
              "type": "string",
              "title": "value"
            },
            "description": "Metadata labels on the volume."
          }
        },
        "title": "Volume",
        "additionalProperties": false,
        "description": "Curated volume, mapped from `container volume list`."
      },
      "micropod.v1.Volume.LabelsEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "type": "string",
            "title": "value"
          }
        },
        "title": "LabelsEntry",
        "additionalProperties": false
      },
      "micropod.v1.VolumePolicy": {
        "type": "object",
        "properties": {
          "cloneMode": {
            "title": "clone_mode",
            "description": "Which named-volume mounts get clonefile-forked per container.",
            "$ref": "#/components/schemas/micropod.v1.VolumePolicy.CloneMode"
          },
          "goldenVolumes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "golden_volumes",
            "description": "Volume names auto-cloned under `CLONE_MODE_GOLDENS`."
          },
          "jobsOnly": {
            "type": "boolean",
            "title": "jobs_only",
            "description": "Restrict cloning to job-labelled containers (`com.cuttlefish.job` /\n `com.micropod.job`). Per-container clone labels always apply."
          },
          "sync": {
            "title": "sync",
            "description": "Writeback sync mode override; `SYNC_MODE_UNSPECIFIED` keeps the\n per-mount default.",
            "$ref": "#/components/schemas/micropod.v1.VolumePolicy.SyncMode"
          },
          "cache": {
            "title": "cache",
            "description": "VZ disk-image cache mode.",
            "$ref": "#/components/schemas/micropod.v1.VolumePolicy.CacheMode"
          }
        },
        "title": "VolumePolicy",
        "additionalProperties": false,
        "description": "Named-volume mount policy \u2014 read on container create by every surface\n (API, docker shim, app, CLI, MCP). Per-container `com.micropod.*` labels\n take precedence over this policy."
      },
      "micropod.v1.VolumePolicy.CacheMode": {
        "type": "string",
        "title": "CacheMode",
        "enum": [
          "CACHE_MODE_UNSPECIFIED",
          "CACHE_MODE_ON",
          "CACHE_MODE_OFF",
          "CACHE_MODE_AUTO"
        ],
        "description": "VZ disk-image caching mode."
      },
      "micropod.v1.VolumePolicy.CloneMode": {
        "type": "string",
        "title": "CloneMode",
        "enum": [
          "CLONE_MODE_UNSPECIFIED",
          "CLONE_MODE_LABELS",
          "CLONE_MODE_GOLDENS",
          "CLONE_MODE_ALL"
        ],
        "description": "Which named-volume mounts get clonefile-forked per container."
      },
      "micropod.v1.VolumePolicy.SyncMode": {
        "type": "string",
        "title": "SyncMode",
        "enum": [
          "SYNC_MODE_UNSPECIFIED",
          "SYNC_MODE_FULL",
          "SYNC_MODE_FSYNC",
          "SYNC_MODE_NOSYNC"
        ],
        "description": "Writeback sync mode for volume disk images."
      }
    }
  },
  "security": [],
  "servers": [
    {
      "url": "http://localhost:45454",
      "description": "Local Micropod daemon"
    }
  ],
  "externalDocs": {
    "description": "API explorer",
    "url": "https://castlemilk.github.io/micropod/api/"
  }
}
