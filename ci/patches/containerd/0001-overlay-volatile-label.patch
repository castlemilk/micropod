diff --git a/plugins/snapshots/overlay/overlay_volatile_test.go b/plugins/snapshots/overlay/overlay_volatile_test.go
new file mode 100644
index 0000000..31dfe57
--- /dev/null
+++ b/plugins/snapshots/overlay/overlay_volatile_test.go
@@ -0,0 +1,58 @@
+//go:build linux
+
+package overlay
+
+import (
+	"context"
+	"slices"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/snapshots"
+)
+
+// Micropod: an active snapshot labelled volatile mounts with the volatile
+// option, at Prepare and at every later Mounts; one without the label, or a
+// view, does not.
+func TestOverlayVolatileLabel(t *testing.T) {
+	ctx := context.TODO()
+	o, err := NewSnapshotter(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer o.Close()
+	if _, err := o.Prepare(ctx, "base-active", ""); err != nil {
+		t.Fatal(err)
+	}
+	if err := o.Commit(ctx, "base", "base-active"); err != nil {
+		t.Fatal(err)
+	}
+	volatile := snapshots.WithLabels(map[string]string{volatileLabel: "true"})
+	for _, tc := range []struct {
+		key  string
+		opts []snapshots.Opt
+		view bool
+		want bool
+	}{
+		{"labelled", []snapshots.Opt{volatile}, false, true},
+		{"plain", nil, false, false},
+		{"labelled-view", []snapshots.Opt{volatile}, true, false},
+	} {
+		prepare := o.Prepare
+		if tc.view {
+			prepare = o.View
+		}
+		at, err := prepare(ctx, tc.key, "base", tc.opts...)
+		if err != nil {
+			t.Fatal(err)
+		}
+		later, err := o.Mounts(ctx, tc.key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, m := range [][]string{at[0].Options, later[0].Options} {
+			if slices.Contains(m, "volatile") != tc.want {
+				t.Errorf("%s: options %q, want volatile %v", tc.key, m, tc.want)
+			}
+		}
+	}
+}
