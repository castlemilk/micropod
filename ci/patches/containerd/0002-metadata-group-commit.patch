+package metadata
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+
+	bolt "go.etcd.io/bbolt"
+)
+
+// Micropod: concurrent Batch callers share transactions; each gets its own
+// answer, a failing function changes nothing and the others still commit.
+func TestBatchSharesTransactionsAndIsolatesFailures(t *testing.T) {
+	ctx, db := testDB(t)
+	_ = ctx
+	var commits int
+	db.RegisterMutationCallback(func(bool) { commits++ })
+	const n = 64
+	errs := make([]error, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			errs[i] = db.Batch(func(tx *bolt.Tx) error {
+				b, err := tx.CreateBucketIfNotExists([]byte("batch-test"))
+				if err != nil {
+					return err
+				}
+				if err := b.Put(fmt.Appendf(nil, "k%d", i), []byte("v")); err != nil {
+					return err
+				}
+				if i%10 == 3 {
+					return fmt.Errorf("caller %d fails", i)
+				}
+				return nil
+			})
+		}()
+	}
+	wg.Wait()
+	for i, err := range errs {
+		if (i%10 == 3) != (err != nil) {
+			t.Fatalf("caller %d: %v", i, err)
+		}
+	}
+	if err := db.View(func(tx *bolt.Tx) error {
+		b := tx.Bucket([]byte("batch-test"))
+		for i := range n {
+			if got := b.Get(fmt.Appendf(nil, "k%d", i)); (got != nil) == (i%10 == 3) {
+				return fmt.Errorf("key %d: %q", i, got)
+			}
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if commits < 1 || commits > n {
+		t.Fatalf("%d mutation callbacks", commits)
+	}
+	t.Logf("%d callers, %d transactions committed", n, commits)
+	if err := db.Batch(func(*bolt.Tx) error { panic("boom") }); err == nil || errors.Is(err, nil) {
+		t.Fatal("a panicking function was not answered with an error")
+	}
+}
