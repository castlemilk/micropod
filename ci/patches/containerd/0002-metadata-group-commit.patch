+// batchUpdate is update for a function whose only effects are its writes to
+// the transaction: without a transaction in the context, it may share one
+// with concurrent callers (DB.Batch).
+func batchUpdate(ctx context.Context, db Transactor, fn func(*bolt.Tx) error) error {
+	if tx, ok := boltutil.Transaction(ctx); ok {
+		if !tx.Writable() {
+			return fmt.Errorf("unable to use transaction from context: %w", errbolt.ErrTxNotWritable)
+		}
+		return fn(tx)
+	}
+	if b, ok := db.(interface {
+		Batch(fn func(*bolt.Tx) error) error
+	}); ok {
+		return b.Batch(fn)
+	}
+	return db.Update(fn)
+}
