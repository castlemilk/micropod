+// Micropod: group commit.
+//
+// Every write transaction of the metadata store commits on its own: bbolt
+// writes its pages and fdatasyncs, then writes its meta page and fdatasyncs
+// again, under one write lock. Start throughput is the rate of those
+// commits. Batch lets callers that arrive while a transaction commits share
+// the next one: one transaction runs every waiting caller's function in
+// arrival order and commits once.
+//
+// Each caller still returns only after the transaction holding its function
+// has committed (bbolt syncs before Commit returns), so what it was told is
+// as durable as with Update. Its writes are all in that one transaction, so
+// they are applied whole or not at all. A function that fails is answered
+// with its error and taken out, and the transaction is run again without it
+// (bbolt cannot roll back part of one): the functions before it run again on
+// the same state, which is why only functions whose only effects are their
+// writes to the transaction may be batched.
+//
+// No caller waits for others to arrive: the first one runs its transaction
+// at once, alone if no one else is waiting.
+
+// batchCall is one caller's function and where its answer goes.
+type batchCall struct {
+	fn  func(*bolt.Tx) error
+	err chan error
+}
+
+// batcher holds the callers waiting for the next transaction, and whether
+// a goroutine is running transactions for them.
+type batcher struct {
+	mu      sync.Mutex
+	pending []*batchCall
+	running bool
+}
+
+// Batch runs fn in a write transaction it may share with concurrent
+// callers (see batcher). fn must change nothing outside tx.
+func (m *DB) Batch(fn func(*bolt.Tx) error) error {
+	call := &batchCall{fn: fn, err: make(chan error, 1)}
+	m.batch.mu.Lock()
+	m.batch.pending = append(m.batch.pending, call)
+	lead := !m.batch.running
+	m.batch.running = true
+	m.batch.mu.Unlock()
+	if lead {
+		m.runBatch()
+	}
+	return <-call.err
+}
+
+// runBatch commits the waiting callers' functions in one transaction. If
+// more arrived meanwhile, a new goroutine runs their transaction, so that
+// the caller running this one is answered as soon as its own has committed.
+func (m *DB) runBatch() {
+	m.batch.mu.Lock()
+	calls := m.batch.pending
+	m.batch.pending = nil
+	m.batch.mu.Unlock()
+
+	m.commitBatch(calls)
+
+	m.batch.mu.Lock()
+	defer m.batch.mu.Unlock()
+	if len(m.batch.pending) == 0 {
+		m.batch.running = false
+		return
+	}
+	go m.runBatch()
+}
+
+func (m *DB) commitBatch(calls []*batchCall) {
+	m.wlock.RLock()
+	defer m.wlock.RUnlock()
+	for len(calls) > 0 {
+		failed := -1
+		err := m.db.Update(func(tx *bolt.Tx) error {
+			for i, c := range calls {
+				if err := callBatched(c.fn, tx); err != nil {
+					failed = i
+					return err
+				}
+			}
+			return nil
+		})
+		if failed >= 0 {
+			calls[failed].err <- err
+			calls = append(calls[:failed:failed], calls[failed+1:]...)
+			continue
+		}
+		if err == nil {
+			dirty := m.dirty.Load() > 0
+			for _, fn := range m.mutationCallbacks {
+				fn(dirty)
+			}
+		}
+		for _, c := range calls {
+			c.err <- err
+		}
+		return
+	}
+}
+
+// callBatched runs one caller's function, turning a panic into its error so
+// that it cannot take the other callers' answers with it.
+func callBatched(fn func(*bolt.Tx) error, tx *bolt.Tx) (err error) {
+	defer func() {
+		if p := recover(); p != nil {
+			err = fmt.Errorf("metadata update panicked: %v", p)
+		}
+	}()
+	return fn(tx)
+}
