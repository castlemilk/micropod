index 0000000..05c9cac
--- /dev/null
+++ b/internal/cri/server/podsandbox/sandbox_shares_micropod_test.go
@@ -0,0 +1,30 @@
+//go:build linux
+
+package podsandbox
+
+import "testing"
+
+// Micropod: a pod's io.micropod.sandbox.cpu-shares annotation sets its
+// sandbox's CPU shares; without it, or with a value out of range, the
+// sandbox keeps the minimum of 2.
+func TestSandboxCPUSharesAnnotation(t *testing.T) {
+	c := newControllerService()
+	for _, tc := range []struct {
+		value string
+		want  uint64
+	}{
+		{"", 2}, {"262144", 262144}, {"2598", 2598}, {"1", 2}, {"262145", 2}, {"x", 2},
+	} {
+		config, imageConfig, _ := getRunPodSandboxTestData(c.config)
+		if tc.value != "" {
+			config.Annotations = map[string]string{sandboxCPUSharesAnnotation: tc.value}
+		}
+		spec, err := c.sandboxContainerSpec("test-id", config, imageConfig, "test-cni", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := *spec.Linux.Resources.CPU.Shares; got != tc.want {
+			t.Errorf("annotation %q: shares %d, want %d", tc.value, got, tc.want)
+		}
+	}
+}
