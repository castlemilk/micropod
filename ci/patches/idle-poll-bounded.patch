+static noinline void __cpuidle cpu_idle_poll_bounded(u64 deadline_ns)
+{
+	instrumentation_begin();
+	trace_cpu_idle(0, smp_processor_id());
+	stop_critical_timings();
+	ct_cpuidle_enter();
+
+	raw_local_irq_enable();
+	while (!tif_need_resched() && ktime_get_mono_fast_ns() < deadline_ns)
+		cpu_relax();
+	raw_local_irq_disable();
+
+	ct_cpuidle_exit();
+	start_critical_timings();
+	trace_cpu_idle(PWR_EVENT_EXIT, smp_processor_id());
+	local_irq_enable();
+	instrumentation_end();
+}
+
