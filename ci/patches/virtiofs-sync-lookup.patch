+static void virtio_fs_wait_lookup(struct virtio_fs_vq *fsvq, struct fuse_req *req)
+{
+	struct virtio_fs_lookup_wait *lookup = &fsvq->lookup;
+	struct fuse_req *done = NULL;
+	unsigned long flags;
+	unsigned int len;
+	bool contended;
+	long wait;
+
+	/* Leave signals and slow replies to the normal FUSE wait after one tick. */
+	wait = wait_event_interruptible_timeout(lookup->waitq,
+			test_bit(FR_FINISHED, &req->flags) || READ_ONCE(lookup->ready), 1);
+
+	spin_lock(&fsvq->lock);
+	spin_lock_irqsave(&lookup->waitq.lock, flags);
+	contended = lookup->contended;
+	WRITE_ONCE(lookup->active, false);
+	WRITE_ONCE(lookup->ready, false);
+	lookup->contended = false;
+	spin_unlock_irqrestore(&lookup->waitq.lock, flags);
+
+	/* The waiter owns the sole submitted request until another send shares it. */
+	if (!contended && wait > 0 && fsvq->connected &&
+	    !test_bit(FR_FINISHED, &req->flags))
+		done = virtqueue_get_buf(fsvq->vq, &len);
+	if (done) {
+		struct fuse_pqueue *fpq = &fsvq->fud->pq;
+
+		virtio_fs_check_response(done, len);
+		spin_lock(&fpq->lock);
+		list_del_init(&done->list);
+		spin_unlock(&fpq->lock);
+		if (!virtqueue_enable_cb(fsvq->vq))
+			schedule_work(&fsvq->done_work);
+	} else if (fsvq->in_flight) {
+		/* Catch a reply whose interrupt raced the switch back to the worker. */
+		schedule_work(&fsvq->done_work);
+	}
+	spin_unlock(&fsvq->lock);
+
+	if (done)
+		virtio_fs_request_complete(done, fsvq);
+}
