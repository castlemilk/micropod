+/* Contention or teardown gives the workqueue responsibility for replies. */
+static void virtio_fs_share_lookup_queue(struct virtio_fs_vq *fsvq)
+{
+	struct virtio_fs_lookup_wait *lookup = &fsvq->lookup;
+	unsigned long flags;
+
+	lockdep_assert_held(&fsvq->lock);
+	if (!lookup->active || lookup->contended)
+		return;
+
+	spin_lock_irqsave(&lookup->waitq.lock, flags);
+	lookup->contended = true;
+	WRITE_ONCE(lookup->ready, true);
+	wake_up_locked(&lookup->waitq);
+	spin_unlock_irqrestore(&lookup->waitq.lock, flags);
+
+	/* The interrupt may already have signalled only the waiter. */
+	schedule_work(&fsvq->done_work);
+}
