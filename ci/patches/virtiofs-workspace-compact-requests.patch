+/*
+ * Small input arguments fit next to their FUSE header. The reply
+ * header and fixed result share a second descriptor. Direct reads keep
+ * their destination folios mapped separately. The protocol byte stream
+ * and the caller's original request header stay intact.
+ *
+ * Returns the number of device-writable descriptors. Zero selects the
+ * ordinary layout, including when the larger bounce allocation fails.
+ */
+static unsigned int virtio_fs_pack_request(struct fuse_req *req,
+					   struct scatterlist *sg, gfp_t gfp)
+{
+	struct fuse_args *args = req->args;
+	unsigned int in_len = 0, out_len, out_offset, alignment, nr = 1;
+	unsigned int i, offset;
+	void *buffer;
+
+	if (!test_bit(FR_ISREPLY, &req->flags) || args->in_pages ||
+	    !args->in_numargs || args->in_numargs > ARRAY_SIZE(args->in_args) ||
+	    args->out_numargs > 1 ||
+	    (args->out_pages && !args->out_numargs))
+		return 0;
+
+	switch (req->in.h.opcode) {
+	case FUSE_LOOKUP:
+	case FUSE_GETATTR:
+	case FUSE_OPEN:
+	case FUSE_READ:
+	case FUSE_RELEASE:
+		break;
+	default:
+		return 0;
+	}
+
+	/* LOOKUP supplies a prefix, a non-NUL-terminated name and its NUL. */
+	for (i = 0; i < args->in_numargs; i++) {
+		if (args->in_args[i].size > NAME_MAX + 1 - in_len)
+			return 0;
+		in_len += args->in_args[i].size;
+	}
+	out_len = args->out_numargs && !args->out_pages ? args->out_args[0].size : 0;
+	if (!in_len || out_len > sizeof(struct fuse_entry_out))
+		return 0;
+
+	in_len += sizeof(req->in.h);
+	out_len += sizeof(req->out.h);
+	/* Align the allocation and the boundary between both DMA mappings. */
+	alignment = dma_get_cache_alignment();
+	out_offset = ALIGN(in_len, alignment);
+	buffer = kmalloc(ALIGN(out_offset + out_len, alignment), gfp | __GFP_NOWARN);
+	if (!buffer)
+		return 0;
+
+	memcpy(buffer, &req->in.h, sizeof(req->in.h));
+	offset = sizeof(req->in.h);
+	for (i = 0; i < args->in_numargs; i++) {
+		if (args->in_args[i].size) {
+			memcpy(buffer + offset, args->in_args[i].value, args->in_args[i].size);
+			offset += args->in_args[i].size;
+		}
+	}
+	sg_init_one(&sg[0], buffer, in_len);
+	sg_init_one(&sg[1], buffer + out_offset, out_len);
+	if (args->out_pages) {
+		struct fuse_args_pages *ap = container_of(args, typeof(*ap), args);
+
+		nr += sg_init_fuse_folios(&sg[2], ap->folios, ap->descs, ap->num_folios,
+					  args->out_args[0].size);
+	}
+	req->argbuf = buffer;
+	req->argbuf_out_header = out_offset;
+	return nr;
 }
 
