+static bool virtio_fs_can_complete_inline(struct fuse_req *req)
+{
+	const struct fuse_args *args = req->args;
+	unsigned long flags = READ_ONCE(req->flags);
+	const unsigned long required = BIT(FR_SENT) | BIT(FR_SYNC_WAKEUP);
+	const unsigned long excluded = BIT(FR_BACKGROUND) | BIT(FR_ASYNC) |
+				       BIT(FR_URING) | BIT(FR_ABORTED) | BIT(FR_FINISHED);
+
+	if ((flags & (required | excluded)) != required || args->may_block ||
+	    args->page_zeroing || args->abort_on_kill)
+		return false;
+
+	/* Direct reads already delivered their bytes into the mapped pages. */
+	return req->in.h.opcode == FUSE_OPEN ||
+	       (req->in.h.opcode == FUSE_READ && args->out_pages);
+}
+
+static bool virtio_fs_inline_completions(struct virtio_fs_vq *fsvq,
+					struct virtqueue *vq)
+{
+	struct fuse_pqueue *fpq;
+	struct fuse_chan *fch;
+	struct fuse_req *req, *next;
+	unsigned int len, budget, max_pages;
+	LIST_HEAD(reqs);
+
+	/* These same locks can be held by an interrupted task. */
+	if (!spin_trylock(&fsvq->lock))
+		return false;
+
+	if (!fsvq->in_flight)
+		goto out;
+	if (!fsvq->connected)
+		goto defer;
+
+	fch = fuse_dev_chan_get(fsvq->fud);
+	max_pages = READ_ONCE(fch->max_pages);
+	if (!max_pages || max_pages > FUSE_IRQ_MAX_PAGES || fch->iq.ops->send_interrupt)
+		goto defer;
+
+	fpq = &fsvq->fud->pq;
+	if (!spin_trylock(&fpq->lock))
+		goto defer;
+	if (!fpq->connected) {
+		spin_unlock(&fpq->lock);
+		goto defer;
+	}
+
+	virtqueue_disable_cb(vq);
+	for (budget = 0; budget < FUSE_IRQ_REPLY_BUDGET; budget++) {
+		req = virtqueue_get_buf(vq, &len);
+		if (!req)
+			break;
+		/* Leave diagnostics for done_work. A valid reply has a header. */
+		if (!virtio_fs_verify_response(req, len, false))
+			req->out.h.len = 0;
+		if (req->out.h.len && virtio_fs_can_complete_inline(req))
+			list_move_tail(&req->list, &reqs);
+		else
+			list_move_tail(&req->list, &fsvq->deferred_replies);
+	}
+	spin_unlock(&fpq->lock);
+
+	/* Recheck for a used buffer published while callbacks were disabled. */
+	if (!virtqueue_enable_cb(vq) || !list_empty(&fsvq->deferred_replies))
+		schedule_work(&fsvq->done_work);
+
+	/* No interrupt-list lock, asynchronous callbacks or folio work here. */
+	list_for_each_entry_safe(req, next, &reqs, list) {
+		list_del_init(&req->list);
+		copy_args_from_argbuf(req->args, req);
+		clear_bit(FR_SENT, &req->flags);
+		fuse_request_end(req);
+		dec_in_flight_req(fsvq);
+	}
+
+	if (!list_empty(&fsvq->queued_reqs))
+		schedule_work(&fsvq->dispatch_work);
+out:
+	spin_unlock(&fsvq->lock);
+	return true;
+defer:
+	spin_unlock(&fsvq->lock);
+	return false;
 }
 
