+static void virtio_fs_notify_post_list(struct virtio_fs *fs,
+				       struct virtio_fs_vq *fsvq,
+				       struct list_head *bufs)
+{
+	struct virtio_fs_notify_buf *nb, *next;
+	struct scatterlist sg;
+	bool notify = false;
+
+	spin_lock(&fsvq->lock);
+	if (!fsvq->connected) {
+		list_splice_tail_init(bufs, &fs->notify_idle);
+		spin_unlock(&fsvq->lock);
+		return;
+	}
+	list_for_each_entry_safe(nb, next, bufs, list) {
+		list_del_init(&nb->list);
+		sg_init_one(&sg, nb->data, fs->notify_buf_size);
+		if (virtqueue_add_inbuf(fsvq->vq, &sg, 1, nb, GFP_ATOMIC) == 0)
+			notify = true;
+		else
+			list_add_tail(&nb->list, &fs->notify_idle);
+	}
+	if (notify)
+		notify = virtqueue_kick_prepare(fsvq->vq);
+	spin_unlock(&fsvq->lock);
+
+	if (notify)
+		virtqueue_notify(fsvq->vq);
+}
