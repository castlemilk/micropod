+static void virtio_fs_notify_done_work(struct work_struct *work)
+{
+	struct virtio_fs_vq *fsvq = container_of(work, struct virtio_fs_vq,
+						 done_work);
+	struct virtqueue *vq = fsvq->vq;
+	struct virtio_fs *fs = vq->vdev->priv;
+	struct virtio_fs_notify_buf *nb;
+	struct fuse_conn *fc = NULL;
+	unsigned int len;
+	LIST_HEAD(bufs);
+
+	spin_lock(&fsvq->lock);
+	if (fsvq->connected && fsvq->fud) {
+		struct fuse_chan *fch = fuse_dev_chan_get(fsvq->fud);
+
+		if (fch && fch->conn)
+			fc = fuse_conn_get(fch->conn);
+	}
+	do {
+		virtqueue_disable_cb(vq);
+		while ((nb = virtqueue_get_buf(vq, &len)) != NULL) {
+			nb->len = min(len, fs->notify_buf_size);
+			list_add_tail(&nb->list, &bufs);
+		}
+	} while (!virtqueue_enable_cb(vq) && likely(!virtqueue_is_broken(vq)));
+	spin_unlock(&fsvq->lock);
+
+	if (fc) {
+		list_for_each_entry(nb, &bufs, list)
+			virtio_fs_handle_notify(fc, nb->data, nb->len);
+		fuse_conn_put(fc);
+	}
+
+	if (!list_empty(&bufs))
+		virtio_fs_notify_post_list(fs, fsvq, &bufs);
+}
+
+static void virtio_fs_notify_populate(struct virtio_fs *fs)
+{
+	struct virtio_fs_vq *fsvq;
+	LIST_HEAD(to_post);
+
+	if (!fs->has_notify || !fs->notify_bufs)
+		return;
+	fsvq = &fs->vqs[VQ_NOTIFY];
+	spin_lock(&fsvq->lock);
+	list_splice_init(&fs->notify_idle, &to_post);
+	spin_unlock(&fsvq->lock);
+	if (!list_empty(&to_post))
+		virtio_fs_notify_post_list(fs, fsvq, &to_post);
+}
+
+static int virtio_fs_alloc_notify_bufs(struct virtio_fs *fs)
+{
+	struct virtqueue *vq = fs->vqs[VQ_NOTIFY].vq;
+	unsigned int i, count;
+
+	INIT_LIST_HEAD(&fs->notify_idle);
+	count = min_t(unsigned int, virtqueue_get_vring_size(vq),
+		      VIRTIO_FS_NOTIFY_MAX_BUFS);
+	if (!count)
+		return -EINVAL;
+	fs->notify_bufs = kcalloc(count, sizeof(*fs->notify_bufs), GFP_KERNEL);
+	if (!fs->notify_bufs)
+		return -ENOMEM;
+	for (i = 0; i < count; i++) {
+		struct virtio_fs_notify_buf *nb;
+
+		nb = kzalloc(sizeof(*nb) + fs->notify_buf_size, GFP_KERNEL);
+		if (!nb)
+			goto err;
+		INIT_LIST_HEAD(&nb->list);
+		fs->notify_bufs[i] = nb;
+		list_add_tail(&nb->list, &fs->notify_idle);
+	}
+	fs->notify_buf_count = count;
+	return 0;
+err:
+	while (i--)
+		kfree(fs->notify_bufs[i]);
+	kfree(fs->notify_bufs);
+	fs->notify_bufs = NULL;
+	INIT_LIST_HEAD(&fs->notify_idle);
+	return -ENOMEM;
+}
+
+static void virtio_fs_free_notify_bufs(struct virtio_fs *fs)
+{
+	unsigned int i;
+
+	if (!fs->notify_bufs)
+		return;
+	for (i = 0; i < fs->notify_buf_count; i++)
+		kfree(fs->notify_bufs[i]);
+	kfree(fs->notify_bufs);
+	fs->notify_bufs = NULL;
+	fs->notify_buf_count = 0;
+	INIT_LIST_HEAD(&fs->notify_idle);
+}
