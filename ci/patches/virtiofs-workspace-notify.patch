+static void virtio_fs_handle_notify(struct fuse_conn *fc, const u8 *buf,
+				    unsigned int len)
+{
+	const struct fuse_out_header *oh;
+	unsigned int body_len;
+
+	if (len < sizeof(*oh))
+		return;
+	oh = (const struct fuse_out_header *)buf;
+	if (oh->len != len || oh->unique != 0)
+		return;
+
+	body_len = len - sizeof(*oh);
+	buf += sizeof(*oh);
+
+	switch (oh->error) {
+	case FUSE_NOTIFY_INVAL_INODE: {
+		const struct fuse_notify_inval_inode_out *arg;
+
+		if (body_len != sizeof(*arg))
+			return;
+		arg = (const struct fuse_notify_inval_inode_out *)buf;
+		down_read(&fc->killsb);
+		fuse_reverse_inval_inode(fc, arg->ino, arg->off, arg->len);
+		up_read(&fc->killsb);
+		break;
+	}
+	case FUSE_NOTIFY_INVAL_ENTRY: {
+		const struct fuse_notify_inval_entry_out *arg;
+		struct qstr name;
+		char *copy;
+
+		if (body_len < sizeof(*arg))
+			return;
+		arg = (const struct fuse_notify_inval_entry_out *)buf;
+		if (arg->namelen == 0 || arg->namelen > fc->name_max ||
+		    body_len < sizeof(*arg) + arg->namelen)
+			return;
+		copy = kmemdup_nul(buf + sizeof(*arg), arg->namelen, GFP_KERNEL);
+		if (!copy)
+			return;
+		name.name = copy;
+		name.len = arg->namelen;
+		down_read(&fc->killsb);
+		fuse_reverse_inval_entry(fc, arg->parent, 0, &name, arg->flags);
+		up_read(&fc->killsb);
+		kfree(copy);
+		break;
+	}
+	case FUSE_NOTIFY_DELETE: {
+		const struct fuse_notify_delete_out *arg;
+		struct qstr name;
+		char *copy;
+
+		if (body_len < sizeof(*arg))
+			return;
+		arg = (const struct fuse_notify_delete_out *)buf;
+		if (arg->namelen == 0 || arg->namelen > fc->name_max ||
+		    body_len < sizeof(*arg) + arg->namelen)
+			return;
+		copy = kmemdup_nul(buf + sizeof(*arg), arg->namelen, GFP_KERNEL);
+		if (!copy)
+			return;
+		name.name = copy;
+		name.len = arg->namelen;
+		down_read(&fc->killsb);
+		fuse_reverse_inval_entry(fc, arg->parent, arg->child, &name, 0);
+		up_read(&fc->killsb);
+		kfree(copy);
+		break;
+	}
+	case FUSE_NOTIFY_INC_EPOCH:
+		atomic_inc(&fc->epoch);
+		break;
+	default:
+		break;
+	}
+}
