    "method": "No socket or VM. Cold process per arm/round, Go 1.27.2, 1 Go CPU, 8 alternating balanced pairs, 100000 requests per cell, exact IN A query on internal network via UDP with one empty OPT record advertising 1232 bytes. Same build inputs and fixture as primary; added Go benchmark body below.",
    "bench_function": "package main\n\nimport (\n  \"context\"\n  \"fmt\"\n  \"testing\"\n  \"golang.org/x/net/dns/dnsmessage\"\n)\n\nfunc BenchmarkEDNS(b *testing.B) {\n  for _,count:=range []int{1,8,256} {\n    b.Run(fmt.Sprintf(\"%d\",count),func(b *testing.B) {\n      n,_:=setup(count)\n      e:=new(dockerEngine)\n      var msg dnsmessage.Message\n      if err:=msg.Unpack(query(b,dnsmessage.TypeA));err!=nil {b.Fatal(err)}\n      msg.Additionals = []dnsmessage.Resource{{Header:dnsmessage.ResourceHeader{Name:dnsmessage.MustNewName(\".\"),Type:dnsmessage.TypeOPT,Class:1232},Body:&dnsmessage.OPTResource{}}}\n      packet,err:=msg.Pack()\n      if err!=nil {b.Fatal(err)}\n      b.ReportAllocs()\n      b.ResetTimer()\n      for i:=0;i<b.N;i++ {\n        if e.dnsReply(context.Background(),n,nil,packet,\"udp\")==nil {b.Fatal(\"no response\")}\n      }\n    })\n  }\n}\n",
