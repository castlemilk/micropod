      "boundary_wire_sha256": "438547ba3bf31b7b4e70cf7361db2d3ba11486ccc48a6309ff1e128740c02453",
      "fixture": "package main\n\nimport (\n  \"context\"\n  \"crypto/sha256\"\n  \"fmt\"\n  \"net/netip\"\n  \"testing\"\n  \"golang.org/x/net/dns/dnsmessage\"\n)\n\nfunc TestEDNSBoundary(t *testing.T) {\n  h := sha256.New()\n  total := 0\n  for _, n := range []int{0,1,8,9,30,31,64,254,255,256} {\n    network, members := setup(n)\n    engine := new(dockerEngine)\n    for _, transport := range []string{\"udp\",\"tcp\"} {\n      for _, advertised := range []int{0,100,512,513,1048,1049,1050,4096,65000} {\n        for _, typ := range []dnsmessage.Type{dnsmessage.TypeA,dnsmessage.TypeALL,dnsmessage.TypeAAAA} {\n          var msg dnsmessage.Message\n          if err := msg.Unpack(query(t,typ)); err != nil { t.Fatal(err) }\n          if advertised != 0 {\n            msg.Additionals = []dnsmessage.Resource{{Header:dnsmessage.ResourceHeader{Name:dnsmessage.MustNewName(\".\"),Type:dnsmessage.TypeOPT,Class:dnsmessage.Class(advertised)},Body:&dnsmessage.OPTResource{}}}\n          }\n          wire,err := msg.Pack()\n          if err!=nil { t.Fatal(err) }\n          actual:=engine.dnsReply(context.Background(),network,nil,wire,transport)\n          var reply dnsmessage.Message\n          if err:=reply.Unpack(actual); err!=nil { t.Fatal(err) }\n          limit:=min(4096,max(512,advertised))\n          num:=n\n          if typ==dnsmessage.TypeAAAA {num=0}\n          tc:=num>0 && transport==\"udp\" && 25+16*num>limit\n          if tc {num=0}\n          code:=dnsmessage.RCodeSuccess\n          if n==0 {code=dnsmessage.RCodeNameError}\n          if len(reply.Answers)!=num || reply.Truncated!=tc || !reply.Authoritative || reply.RCode!=code ||\n             len(reply.Questions)!=1 || reply.Questions[0]!=msg.Questions[0] || reply.ID!=msg.ID {\n             t.Fatalf(\"%d %s %d %d %d answers tc %v rcode %v\",n,transport,advertised,typ,len(reply.Answers),reply.Truncated,reply.RCode)\n          }\n          for i,a:=range reply.Answers {\n            bytes:=a.Body.(*dnsmessage.AResource).A\n            if fmt.Sprintf(\"%d.%d.%d.%d\",bytes[0],bytes[1],bytes[2],bytes[3])!=members[i].IP {\n              t.Fatalf(\"unordered or wrong address at %d\",i)\n            }\n          }\n          fmt.Fprintf(h,\"%d:\",len(actual));h.Write(actual);total++\n        }\n      }\n    }\n  }\n  t.Logf(\"verified %d replies %x\",total,h.Sum(nil))\n}\n\nfunc TestMaxRecordCount(t *testing.T) {\n  h:=sha256.New()\n  for _,count:=range []int{65535,65536} {\n    n:=&workerNetwork{Internal:true}\n    rows:=make([]netip.Addr,count)\n    for i:=range rows {rows[i]=netip.AddrFrom4([4]byte{10,byte(i>>16),byte(i>>8),byte(i)})}\n    n.services.records=map[string][]netip.Addr{\"web.svc\":rows}\n    engine:=new(dockerEngine)\n    for _,transport:=range []string{\"udp\",\"tcp\"} {\n      wire:=engine.dnsReply(context.Background(),n,nil,query(t,dnsmessage.TypeA),transport)\n      if count==65536 {\n        if wire!=nil {t.Fatalf(\"unexpected unrepresentable %s reply\",transport)}\n        continue\n      }\n      var reply dnsmessage.Message\n      if err:=reply.Unpack(wire);err!=nil {t.Fatal(err)}\n      expected:=count\n      if transport==\"udp\" {expected=0}\n      if len(reply.Answers)!=expected || reply.Truncated!=(transport==\"udp\"){t.Fatalf(\"unexpected boundary response\")}\n      fmt.Fprintf(h,\"%d:\",len(wire));h.Write(wire)\n    }\n  }\n  t.Logf(\"verified 4 record-count boundaries %x\",h.Sum(nil))\n}\n"
    }
  }
