int main(int argc, char **argv)
{
    if (argc != 6) return 2;
    struct Scheduler sch = { .limit = (unsigned int)atoi(argv[1]) };
    struct Queue q = { .flow_plimit = (unsigned int)atoi(argv[2]) };
    unsigned int flows = (unsigned int)atoi(argv[3]);
    struct Flow f = { .qlen = (unsigned int)atoi(argv[4]) };
    struct Packet skb = { .priority = (unsigned int)atoi(argv[5]) };
    fq_prio2band_compress_crumb(sch_default_prio2band, q.prio2band);
    q.band_pkt_count[fq_prio2band(q.prio2band, 0)] = flows * q.flow_plimit;
    const char *reasons[] = {"admit", "band_limit", "flow_limit"};
    int result = check(&q, &sch, &f, &skb);
    printf("%u %s\n", fq_prio2band(q.prio2band, skb.priority), reasons[result]);
    return 0;
}
