 // Read directly into the worker scratch and immediately write to the peer.
 // On backpressure, keep just the unwritten suffix and pause that reader.
+enum { RETRY_BATCH_BYTES = 16 * 1024 };
+
+static void batch_large_retry(struct endpoint *dst, size_t remaining) {
+    if (remaining < RETRY_BATCH_BYTES) return;
+    int fd = dst->watch.fd, space, previous, threshold = RETRY_BATCH_BYTES;
+    socklen_t size = sizeof(int);
+    if (getsockopt(fd, SOL_SOCKET, SO_SNDBUF, &space, &size) == 0 && space >= threshold &&
+        getsockopt(fd, SOL_SOCKET, SO_SNDLOWAT, &previous, &size) == 0 &&
+        previous > 0 && previous < threshold &&
+        setsockopt(fd, SOL_SOCKET, SO_SNDLOWAT, &threshold, sizeof(threshold)) == 0) {
+        dst->saved_send_lowat = previous;
+    }
+}
+
+static int restore_retry_threshold(struct endpoint *dst) {
+    if (!dst->saved_send_lowat) return 0;
+    int rc = setsockopt(dst->watch.fd, SOL_SOCKET, SO_SNDLOWAT,
+                        &dst->saved_send_lowat, sizeof(dst->saved_send_lowat));
+    if (!rc) dst->saved_send_lowat = 0;
+    return rc;
+}
