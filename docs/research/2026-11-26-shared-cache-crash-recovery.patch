diff --git a/guest/runner/caches_dirty_linux.go b/guest/runner/caches_dirty_linux.go
new file mode 100644
index 0000000..b563a11
--- /dev/null
+++ b/guest/runner/caches_dirty_linux.go
@@ -0,0 +1,283 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"maps"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Crash safety of the shared stores.
+//
+// Tools write cache entries to a temporary name and rename them into place
+// without fsync (Go's module cache does). On ext4 with delayed allocation the
+// journal can commit such a rename seconds before the file's data reaches the
+// disk, so a kill -9 of the VMM leaves zero-length entries behind (measured:
+// two empty .mod files in gomod, after which `go mod verify` and every build
+// failed with a checksum mismatch for every container of the scope). A shared
+// store would keep serving that damage until someone cleaned it by hand.
+//
+// So a unit is marked dirty (.meta/<scope>/<unit>.dirty) before a container
+// that binds it starts, and the mark is removed only after the container has
+// exited and a syncfs of the cache filesystem has completed. An orderly stop
+// syncs and clears every mark. Marks found when the engine starts therefore
+// name exactly the units that may hold writes that never reached the disk:
+// those are moved to .trash (the next container gets an empty store, one cold
+// run) and everything else stays warm.
+
+type cacheDirtyTracker struct {
+	mu      sync.Mutex
+	pins    map[string]int    // scope/unit -> running containers that bind it
+	gen     map[string]uint64 // bumped on every attach
+	pending map[string]uint64 // unpinned units waiting for a sync -> gen when unpinned
+	kick    chan struct{}
+}
+
+var cacheDirty = newCacheDirtyTracker()
+
+func newCacheDirtyTracker() *cacheDirtyTracker {
+	return &cacheDirtyTracker{pins: map[string]int{}, gen: map[string]uint64{}, pending: map[string]uint64{}, kick: make(chan struct{}, 1)}
+}
+
+func dirtyMarker(scope, unit string) string {
+	return filepath.Join(cacheRoot, ".meta", scope, unit+".dirty")
+}
+
+// attach pins a unit for one container start and makes sure its dirty mark
+// exists before the container can write to it. The mark's creation is a
+// journaled metadata change made before any of the container's, so any
+// rename of the container's that survives a crash implies the mark did too.
+func (t *cacheDirtyTracker) attach(scope, unit string) error {
+	k := scope + "/" + unit
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.pins[k]++
+	t.gen[k]++
+	delete(t.pending, k)
+	f, err := os.OpenFile(dirtyMarker(scope, unit), os.O_CREATE|os.O_WRONLY|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return err
+	}
+	return f.Close()
+}
+
+// release unpins a unit after its container exited; the syncer clears the
+// mark once the container's writes are on disk.
+func (t *cacheDirtyTracker) release(scope, unit string) {
+	k := scope + "/" + unit
+	t.mu.Lock()
+	if t.pins[k] > 0 {
+		t.pins[k]--
+	}
+	if t.pins[k] == 0 {
+		delete(t.pins, k)
+		t.pending[k] = t.gen[k]
+	}
+	t.mu.Unlock()
+	select {
+	case t.kick <- struct{}{}:
+	default:
+	}
+}
+
+// syncOnce syncs the cache filesystem and clears the marks of the units that
+// were unpinned, and not attached again, before the sync started.
+func (t *cacheDirtyTracker) syncOnce() error {
+	t.mu.Lock()
+	snap := maps.Clone(t.pending)
+	t.mu.Unlock()
+	if len(snap) == 0 {
+		return nil
+	}
+	if err := syncCacheFS(); err != nil {
+		return err
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	for k, g := range snap {
+		if t.pins[k] != 0 || t.gen[k] != g {
+			continue
+		}
+		scope, unit, _ := strings.Cut(k, "/")
+		if err := os.Remove(dirtyMarker(scope, unit)); err != nil && !errors.Is(err, os.ErrNotExist) {
+			log.Printf("cache %s: clear dirty mark: %v", k, err)
+			continue
+		}
+		delete(t.pending, k)
+		delete(t.gen, k)
+	}
+	return nil
+}
+
+// run clears marks a couple of seconds after containers exit (coalescing
+// exits that arrive together) until ctx ends.
+func (t *cacheDirtyTracker) run(ctx context.Context) {
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.kick:
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(2 * time.Second):
+		}
+		if err := t.syncOnce(); err != nil {
+			log.Printf("cache sync: %v", err)
+		}
+	}
+}
+
+// shutdown is the orderly stop: sync, then clear every mark, pinned units
+// included (guest init syncs again after it has stopped every process).
+func (t *cacheDirtyTracker) shutdown() {
+	if err := syncCacheFS(); err != nil {
+		log.Printf("cache sync at shutdown: %v", err)
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	for _, m := range listDirtyMarks() {
+		if err := os.Remove(dirtyMarker(m[0], m[1])); err != nil && !errors.Is(err, os.ErrNotExist) {
+			log.Printf("cache %s/%s: clear dirty mark: %v", m[0], m[1], err)
+		}
+	}
+	t.pending = map[string]uint64{}
+}
+
+func syncCacheFS() error {
+	f, err := os.Open(cacheRoot)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+	defer f.Close()
+	return unix.Syncfs(int(f.Fd()))
+}
+
+// listDirtyMarks returns {scope, unit} for every .meta/<scope>/<unit>.dirty.
+func listDirtyMarks() [][2]string {
+	var out [][2]string
+	scopes, _ := os.ReadDir(filepath.Join(cacheRoot, ".meta"))
+	for _, s := range scopes {
+		if !s.IsDir() || !scopeName.MatchString(s.Name()) {
+			continue
+		}
+		entries, _ := os.ReadDir(filepath.Join(cacheRoot, ".meta", s.Name()))
+		for _, e := range entries {
+			if unit, ok := strings.CutSuffix(e.Name(), ".dirty"); ok && e.Type().IsRegular() {
+				out = append(out, [2]string{s.Name(), unit})
+			}
+		}
+	}
+	return out
+}
+
+// parseCacheUnit splits <kind> or <kind>.u<uid>.
+func parseCacheUnit(unit string) (string, *uint32, bool) {
+	kind, part, found := strings.Cut(unit, ".u")
+	if cacheToolByKind(kind) == nil {
+		return "", nil, false
+	}
+	if !found {
+		return kind, nil, true
+	}
+	n, err := strconv.ParseUint(part, 10, 32)
+	if err != nil {
+		return "", nil, false
+	}
+	uid := uint32(n)
+	return kind, &uid, true
+}
+
+// cacheDiscarded lists the units this boot moved to .trash, for GET /micropod/caches.
+var cacheDiscarded []string
+
+// discardDirtyCaches runs at engine start, before the socket opens: every
+// unit still marked dirty may hold torn entries, so it is moved to .trash.
+// Nothing runs yet, so no container holds any of them.
+func discardDirtyCaches() {
+	marks := listDirtyMarks()
+	if len(marks) == 0 {
+		go emptyCacheTrash()
+		return
+	}
+	l, err := openCacheLayout()
+	if err != nil {
+		log.Printf("cache recovery: %v", err)
+		return
+	}
+	defer l.Close()
+	for _, m := range marks {
+		scope, unit := m[0], m[1]
+		if err := discardUnit(l, scope, unit); err != nil {
+			log.Printf("cache %s/%s: discard after an unclean stop: %v", scope, unit, err)
+			continue
+		}
+		if err := os.Remove(dirtyMarker(scope, unit)); err != nil && !errors.Is(err, os.ErrNotExist) {
+			log.Printf("cache %s/%s: clear dirty mark: %v", scope, unit, err)
+		}
+		cacheDiscarded = append(cacheDiscarded, scope+"/"+unit)
+		log.Printf("cache %s/%s: discarded: the machine stopped while it could hold unsynced writes", scope, unit)
+	}
+	if err := unix.Syncfs(int(l.root.Fd())); err != nil {
+		log.Printf("cache recovery sync: %v", err)
+	}
+	go emptyCacheTrash()
+}
+
+// discardUnit renames scopes/<scope>/<kind>[/u<uid>] into .trash without
+// following a symlink anywhere on the way.
+func discardUnit(l cacheLayout, scope, unit string) error {
+	kind, uid, ok := parseCacheUnit(unit)
+	if !ok || !scopeName.MatchString(scope) {
+		return fmt.Errorf("not a cache unit")
+	}
+	scopeDir, err := openDirNoFollow(int(l.scopes.Fd()), scope, filepath.Join(l.scopes.Name(), scope))
+	if errors.Is(err, unix.ENOENT) {
+		return nil
+	} else if err != nil {
+		return err
+	}
+	defer scopeDir.Close()
+	parent, name := scopeDir, kind
+	if uid != nil {
+		kindDir, err := openDirNoFollow(int(scopeDir.Fd()), kind, filepath.Join(scopeDir.Name(), kind))
+		if errors.Is(err, unix.ENOENT) {
+			return nil
+		} else if err != nil {
+			return err
+		}
+		defer kindDir.Close()
+		parent, name = kindDir, "u"+strconv.FormatUint(uint64(*uid), 10)
+	}
+	err = unix.Renameat(int(parent.Fd()), name, int(l.trash.Fd()), trashName(scope+"."+unit))
+	if errors.Is(err, unix.ENOENT) {
+		return nil
+	}
+	return err
+}
+
+// emptyCacheTrash deletes what earlier boots and this one moved to .trash.
+func emptyCacheTrash() {
+	dir := filepath.Join(cacheRoot, ".trash")
+	entries, _ := os.ReadDir(dir)
+	for _, e := range entries {
+		if err := os.RemoveAll(filepath.Join(dir, e.Name())); err != nil {
+			log.Printf("cache trash %s: %v", e.Name(), err)
+		}
+	}
+}
diff --git a/guest/runner/caches_dirty_linux_test.go b/guest/runner/caches_dirty_linux_test.go
new file mode 100644
index 0000000..557d8fe
--- /dev/null
+++ b/guest/runner/caches_dirty_linux_test.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func TestParseCacheUnit(t *testing.T) {
+	for unit, want := range map[string]string{"gomod": "gomod", "pip.u1000": "pip/u1000", "yarn.u0": "yarn/u0", "uv": "uv"} {
+		kind, uid, ok := parseCacheUnit(unit)
+		if !ok || cacheStoreSub(kind, uid) != want {
+			t.Fatalf("%s: %s %v %v", unit, kind, uid, ok)
+		}
+	}
+	for _, bad := range []string{"", "maven", "pip.uroot", "pip.u-1", "../x"} {
+		if _, _, ok := parseCacheUnit(bad); ok {
+			t.Fatalf("parsed %q", bad)
+		}
+	}
+}
+
+// A unit is marked dirty while a container binds it and until a sync after it
+// exits; a mark left by an unclean stop discards exactly that unit at start.
+func TestCacheDirtyMarksAndDiscard(t *testing.T) {
+	needRoot(t)
+	useCacheRoot(t)
+	old := cacheDirty
+	cacheDirty = newCacheDirtyTracker()
+	t.Cleanup(func() { cacheDirty = old; cacheDiscarded = nil })
+	marked := func(scope, unit string) bool {
+		_, err := os.Lstat(dirtyMarker(scope, unit))
+		return err == nil
+	}
+	f := testFacts(golangEnv, nil)
+	plan := decide(t, defaultCachePolicy(), dockerConfig{}, f)
+	a := openCacheMounts(&plan, "")
+	b := openCacheMounts(&plan, "")
+	if !slices.Contains(a.units, "gomod") || !marked("default", "gomod") || !marked("default", "pip.u0") {
+		t.Fatalf("units %v not marked", a.units)
+	}
+	// One of two containers exits: the unit stays pinned, a sync keeps the mark.
+	a.release()
+	a.release() // idempotent
+	if err := cacheDirty.syncOnce(); err != nil {
+		t.Fatal(err)
+	}
+	if !marked("default", "gomod") {
+		t.Fatal("a sync cleared the mark of a unit another container still binds")
+	}
+	b.release()
+	// Attached again before the sync ran: the snapshot is stale, the mark stays.
+	c := openCacheMounts(&plan, "")
+	if err := cacheDirty.syncOnce(); err != nil {
+		t.Fatal(err)
+	}
+	if !marked("default", "gomod") {
+		t.Fatal("mark cleared while a newer container binds the unit")
+	}
+	c.release()
+	if err := cacheDirty.syncOnce(); err != nil {
+		t.Fatal(err)
+	}
+	if marked("default", "gomod") || marked("default", "pip.u0") {
+		t.Fatal("marks survive after every container exited and a sync ran")
+	}
+	closeMounts(a.files)
+	closeMounts(b.files)
+	closeMounts(c.files)
+
+	// An unclean stop: a container wrote into the stores and its marks remain.
+	d := openCacheMounts(&plan, "")
+	store := filepath.Join(cacheRoot, "scopes/default")
+	if err := os.WriteFile(filepath.Join(store, "gomod", "torn.mod"), nil, 0666); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(store, "pip", "u0", "torn"), nil, 0666); err != nil {
+		t.Fatal(err)
+	}
+	closeMounts(d.files)
+	// A unit nobody bound since the last sync is left alone.
+	if err := os.WriteFile(filepath.Join(store, "npm", "kept"), []byte("x"), 0666); err != nil {
+		t.Fatal(err)
+	}
+	os.Remove(dirtyMarker("default", "npm"))
+	cacheDirty = newCacheDirtyTracker() // the next boot's engine
+	discardDirtyCaches()
+	for _, p := range []string{"gomod/torn.mod", "pip/u0/torn"} {
+		if _, err := os.Lstat(filepath.Join(store, p)); !os.IsNotExist(err) {
+			t.Fatalf("%s survived the discard: %v", p, err)
+		}
+	}
+	if _, err := os.Lstat(filepath.Join(store, "npm", "kept")); err != nil {
+		t.Fatalf("an unmarked unit was discarded: %v", err)
+	}
+	if len(listDirtyMarks()) != 0 {
+		t.Fatalf("marks left after the discard: %v", listDirtyMarks())
+	}
+	if !slices.Contains(cacheDiscarded, "default/gomod") || !slices.Contains(cacheDiscarded, "default/pip.u0") || slices.Contains(cacheDiscarded, "default/npm") {
+		t.Fatalf("discarded %v", cacheDiscarded)
+	}
+	// The next container gets fresh, correctly made stores.
+	e := openCacheMounts(&plan, "")
+	defer closeMounts(e.files)
+	if len(e.skipped) != 0 {
+		t.Fatalf("skipped after the discard: %v", e.skipped)
+	}
+	if mode, _ := modeOf(t, filepath.Join(store, "gomod")); mode != 0777 {
+		t.Fatalf("recreated gomod %o", mode)
+	}
+	// An orderly stop clears every mark, pinned units included.
+	cacheDirty.shutdown()
+	if len(listDirtyMarks()) != 0 {
+		t.Fatalf("marks left after shutdown: %v", listDirtyMarks())
+	}
+}
