{
  "openapi": "3.1.0",
  "info": {
    "title": "micropod.v1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "micropod.v1.ComposeDownRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "minLength": 1,
            "description": "Compose project name."
          }
        },
        "title": "ComposeDownRequest",
        "additionalProperties": false,
        "description": "Tear down a compose project's containers."
      },
      "micropod.v1.ComposeNetwork": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "description": "Network name within the compose project."
          },
          "internal": {
            "type": "boolean",
            "title": "internal",
            "description": "Isolate the network from external traffic."
          },
          "external": {
            "type": "boolean",
            "title": "external",
            "description": "References a pre-existing network outside the project."
          },
          "driver": {
            "type": "string",
            "title": "driver",
            "description": "Network driver to use."
          },
          "driverOpts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "driver_opts",
            "description": "Plugin options (compose `driver_opts` -\u003e `--option`)."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "labels"
          },
          "subnet": {
            "type": "string",
            "title": "subnet",
            "description": "From `ipam.config[0].subnet` / `subnet_v6`.\n IPv4 CIDR (from `ipam.config[0].subnet`)."
          },
          "subnetV6": {
            "type": "string",
            "title": "subnet_v6",
            "description": "IPv6 CIDR."
          },
          "externalName": {
            "type": "string",
            "title": "external_name",
            "description": "`external: {name: \"…\"}` override."
          }
        },
        "title": "ComposeNetwork",
        "additionalProperties": false
      },
      "micropod.v1.ComposeService": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "description": "Service name from the compose file."
          },
          "image": {
            "type": "string",
            "title": "image",
            "description": "Image reference for the service."
          },
          "buildContext": {
            "type": "string",
            "title": "build_context",
            "description": "Build context dir if the service is built from a Dockerfile."
          },
          "buildDockerfile": {
            "type": "string",
            "title": "build_dockerfile",
            "description": "Dockerfile path relative to the build context."
          },
          "buildArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "build_args",
            "description": "Build args as KEY=value pairs."
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "depends_on",
            "description": "Service names that must start before this one."
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.PortMapping"
            },
            "title": "ports",
            "description": "Published port mappings."
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "environment",
            "description": "Environment variables as KEY=value pairs."
          },
          "volumes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "volumes",
            "description": "Volume/bind mounts in compose syntax."
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "commands",
            "description": "Command override (compose `command`)."
          },
          "workingDir": {
            "type": "string",
            "title": "working_dir",
            "description": "Working directory inside the container."
          },
          "restart": {
            "type": "string",
            "title": "restart",
            "description": "Restart policy: \"no\", \"always\", \"unless-stopped\", \"on-failure[:N]\"."
          },
          "cpus": {
            "type": "number",
            "title": "cpus",
            "format": "double",
            "description": "Resource caps (compose `cpus`, `mem_limit`)."
          },
          "memory": {
            "type": "string",
            "title": "memory"
          },
          "healthcheckCommand": {
            "type": "string",
            "title": "healthcheck_command",
            "description": "Healthcheck command; used for real readiness probes."
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "networks",
            "description": "Networks the service attaches to."
          },
          "containerName": {
            "type": "string",
            "title": "container_name",
            "description": "Explicit container name override (compose `container_name`)."
          },
          "entrypoint": {
            "type": "string",
            "title": "entrypoint",
            "description": "Entrypoint override (compose `entrypoint`)."
          },
          "user": {
            "type": "string",
            "title": "user",
            "description": "User for the container process (format: name|uid[:gid])."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "labels",
            "description": "key=value container labels."
          },
          "dns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "dns",
            "description": "DNS nameserver IPs (compose `dns`)."
          },
          "dnsSearch": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "dns_search",
            "description": "DNS search domains (compose `dns_search`)."
          },
          "capAdd": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "cap_add",
            "description": "Linux capabilities to add."
          },
          "capDrop": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "cap_drop",
            "description": "Linux capabilities to drop."
          },
          "ulimits": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "ulimits",
            "description": "Resource limits, format: type=soft[:hard]."
          },
          "tmpfs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "tmpfs",
            "description": "tmpfs mounts: path or path:size."
          },
          "envFile": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "env_file",
            "description": "env_file paths (resolved against the compose file directory)."
          },
          "shmSize": {
            "type": "string",
            "title": "shm_size",
            "description": "Size of /dev/shm, e.g. \"64m\"."
          },
          "readOnly": {
            "type": "boolean",
            "title": "read_only",
            "description": "Mount the root filesystem read-only."
          },
          "init": {
            "type": "boolean",
            "title": "init",
            "description": "Run an init process as PID 1."
          },
          "tty": {
            "type": "boolean",
            "title": "tty",
            "description": "Allocate a pseudo-TTY."
          },
          "stdinOpen": {
            "type": "boolean",
            "title": "stdin_open",
            "description": "Keep stdin open."
          },
          "privileged": {
            "type": "boolean",
            "title": "privileged",
            "description": "Parsed but not expressible on the Apple runtime."
          },
          "extraHosts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "extra_hosts",
            "description": "Extra /etc/hosts entries as \"host:ip\" pairs."
          },
          "dependsOnConditions": {
            "type": "object",
            "title": "depends_on_conditions",
            "additionalProperties": {
              "type": "string",
              "title": "value"
            },
            "description": "Conditions for depends_on entries (key = dependency name):\n \"started\" (default) or \"service_healthy\"."
          },
          "healthcheckIntervalSeconds": {
            "type": "integer",
            "title": "healthcheck_interval_seconds",
            "format": "int32",
            "description": "Seconds between healthcheck runs."
          },
          "healthcheckTimeoutSeconds": {
            "type": "integer",
            "title": "healthcheck_timeout_seconds",
            "format": "int32",
            "description": "Seconds before a healthcheck is considered failed."
          },
          "healthcheckRetries": {
            "type": "integer",
            "title": "healthcheck_retries",
            "format": "int32",
            "description": "Consecutive failures before the container is marked unhealthy."
          },
          "healthcheckStartPeriodSeconds": {
            "type": "integer",
            "title": "healthcheck_start_period_seconds",
            "format": "int32",
            "description": "Grace period at start during which failures don't count."
          },
          "buildTarget": {
            "type": "string",
            "title": "build_target",
            "description": "Build stage target / platform for `build:` sections."
          },
          "buildPlatform": {
            "type": "string",
            "title": "build_platform"
          },
          "buildNoCache": {
            "type": "boolean",
            "title": "build_no_cache",
            "description": "`build.no_cache` / `build.pull` passthrough."
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "profiles",
            "description": "Compose profiles; the service only runs when an enabled profile matches."
          },
          "pullPolicy": {
            "type": "string",
            "title": "pull_policy",
            "description": "Image pull policy: \"always\" forces a pull, anything else pulls only when\n the image is not present locally (docker's default \"missing\")."
          },
          "stopSignal": {
            "type": "string",
            "title": "stop_signal",
            "description": "Stop behaviour (parsed; stop_signal is not expressible, grace period\n maps to `container stop --time`).\n Signal sent on stop (parsed; not expressible on the Apple runtime)."
          },
          "stopGracePeriodSeconds": {
            "type": "integer",
            "title": "stop_grace_period_seconds",
            "format": "int32",
            "description": "Seconds between SIGTERM and SIGKILL on stop."
          }
        },
        "title": "ComposeService",
        "additionalProperties": false,
        "description": "A single service of a compose spec, mapped onto `container run` capabilities.\n Fields the Apple runtime cannot express (e.g. privileged) are still parsed\n so the UI can show them as unsupported rather than silently dropping them."
      },
      "micropod.v1.ComposeService.DependsOnConditionsEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "type": "string",
            "title": "value"
          }
        },
        "title": "DependsOnConditionsEntry",
        "additionalProperties": false
      },
      "micropod.v1.ComposeSpec": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "description": "Compose project name (top-level `name:` or the directory name)."
          },
          "path": {
            "type": "string",
            "title": "path",
            "description": "Absolute path of the docker-compose.yml this spec was parsed from."
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ComposeService"
            },
            "title": "services",
            "description": "Services in dependency order."
          },
          "volumes": {
            "type": "object",
            "title": "volumes",
            "additionalProperties": {
              "title": "value",
              "$ref": "#/components/schemas/micropod.v1.ComposeVolume"
            },
            "description": "Named volumes declared at the top level."
          },
          "networks": {
            "type": "object",
            "title": "networks",
            "additionalProperties": {
              "title": "value",
              "$ref": "#/components/schemas/micropod.v1.ComposeNetwork"
            },
            "description": "Networks declared at the top level."
          }
        },
        "title": "ComposeSpec",
        "additionalProperties": false,
        "description": "Parsed docker-compose.yml, produced by the compose importer."
      },
      "micropod.v1.ComposeSpec.NetworksEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "title": "value",
            "$ref": "#/components/schemas/micropod.v1.ComposeNetwork"
          }
        },
        "title": "NetworksEntry",
        "additionalProperties": false
      },
      "micropod.v1.ComposeSpec.VolumesEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "key"
          },
          "value": {
            "title": "value",
            "$ref": "#/components/schemas/micropod.v1.ComposeVolume"
          }
        },
        "title": "VolumesEntry",
        "additionalProperties": false
      },
      "micropod.v1.ComposeUpEvent": {
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "title": "line",
            "description": "Progress output line — empty on the terminal event."
          },
          "name": {
            "type": "string",
            "title": "name",
            "description": "Compose project name — set only on the terminal event."
          },
          "done": {
            "type": "boolean",
            "title": "done",
            "description": "True on the terminal event once every service is up."
          }
        },
        "title": "ComposeUpEvent",
        "additionalProperties": false,
        "description": "One ComposeUp stream event: progress output lines, then a terminal\n marker once every service is up."
      },
      "micropod.v1.ComposeUpRequest": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "path",
            "minLength": 1,
            "description": "Absolute path to the compose YAML on the host."
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "profiles",
            "description": "Compose profiles to enable (service runs only when one matches)."
          }
        },
        "title": "ComposeUpRequest",
        "additionalProperties": false,
        "description": "Bring a compose project up from a spec file — ComposeUp streams progress."
      },
      "micropod.v1.ComposeVolume": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "name",
            "description": "Volume name within the compose project."
          },
          "external": {
            "type": "boolean",
            "title": "external",
            "description": "References a pre-existing volume outside the project."
          },
          "driver": {
            "type": "string",
            "title": "driver",
            "description": "Driver + driver options (`driver_opts`), labels."
          },
          "driverOpts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "driver_opts"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "labels"
          },
          "externalName": {
            "type": "string",
            "title": "external_name",
            "description": "`external: {name: \"…\"}` override."
          }
        },
        "title": "ComposeVolume",
        "additionalProperties": false
      },
      "micropod.v1.PortMapping": {
        "type": "object",
        "properties": {
          "hostPort": {
            "type": "integer",
            "title": "host_port",
            "maximum": 65535,
            "description": "Port on the host."
          },
          "containerPort": {
            "type": "integer",
            "title": "container_port",
            "maximum": 65535,
            "description": "Port inside the container."
          },
          "protocol": {
            "type": "string",
            "title": "protocol",
            "description": "\"tcp\" or \"udp\"."
          },
          "hostIp": {
            "type": "string",
            "title": "host_ip",
            "description": "Host interface IP to bind (empty = all interfaces)."
          }
        },
        "title": "PortMapping",
        "required": [
          "containerPort"
        ],
        "additionalProperties": false,
        "description": "A published port mapping between host and container."
      }
    }
  },
  "security": []
}