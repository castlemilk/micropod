            }
          },
          "rosetta": {
            "type": "boolean",
            "title": "rosetta"
          },
          "readOnly": {
            "type": "boolean",
            "title": "read_only"
          },
          "useInit": {
            "type": "boolean",
            "title": "use_init"
          },
          "ssh": {
            "type": "boolean",
            "title": "ssh"
          },
          "virtualization": {
            "type": "boolean",
            "title": "virtualization"
          },
          "runtimeHandler": {
            "type": "string",
            "title": "runtime_handler"
          },
          "exitCode": {
            "type": "string",
            "title": "exit_code"
