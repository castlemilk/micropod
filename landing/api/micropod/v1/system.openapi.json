{
  "openapi": "3.1.0",
  "info": {
    "title": "Micropod API \u00b7 SystemService",
    "description": "## micropod.v1.SystemService\n\nDaemon-level operations: runtime snapshot, cleanup usage report, and the\n desktop app's update lifecycle (proxied over the app control socket).",
    "version": "0.8.0",
    "contact": {
      "name": "Micropod",
      "url": "https://github.com/castlemilk/micropod"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/castlemilk/micropod/blob/master/LICENSE"
    }
  },
  "paths": {
    "/api/micropod.v1.SystemService/ApplyUpdate": {
      "post": {
        "tags": [
          "micropod.v1.SystemService"
        ],
        "summary": "ApplyUpdate",
        "description": "Quit the app so a downloaded update installs and relaunches. Fails\n with `failed_precondition` until `UpdateStatus.ready_to_install`.",
        "operationId": "micropod.v1.SystemService.ApplyUpdate",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.UpdateStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.SystemService/CheckForUpdates": {
      "post": {
        "tags": [
          "micropod.v1.SystemService"
        ],
        "summary": "CheckForUpdates",
        "description": "Trigger a background update check in the desktop app (Sparkle).\n Fails with `unavailable` when the app isn't running.",
        "operationId": "micropod.v1.SystemService.CheckForUpdates",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.UpdateStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.SystemService/GetSystem": {
      "post": {
        "tags": [
          "micropod.v1.SystemService"
        ],
        "summary": "GetSystem",
        "description": "Runtime status + disk usage.",
        "operationId": "micropod.v1.SystemService.GetSystem",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.SystemSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.SystemService/GetUpdateStatus": {
      "post": {
        "tags": [
          "micropod.v1.SystemService"
        ],
        "summary": "GetUpdateStatus",
        "description": "Last-known updater status from the desktop app.",
        "operationId": "micropod.v1.SystemService.GetUpdateStatus",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.UpdateStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/micropod.v1.SystemService/GetUsage": {
      "post": {
        "tags": [
          "micropod.v1.SystemService"
        ],
        "summary": "GetUsage",
        "description": "What a cleanup would reclaim: images and volumes annotated with the\n containers that reference them.",
        "operationId": "micropod.v1.SystemService.GetUsage",
        "parameters": [
          {
            "name": "Connect-Protocol-Version",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/connect-protocol-version"
            }
          },
          {
            "name": "Connect-Timeout-Ms",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/connect-timeout-header"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/micropod.v1.Empty"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connect.error"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/micropod.v1.UsageReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "connect-protocol-version": {
        "type": "number",
        "title": "Connect-Protocol-Version",
        "enum": [
          1
        ],
        "description": "Define the version of the Connect protocol",
        "const": 1
      },
      "connect-timeout-header": {
        "type": "number",
        "title": "Connect-Timeout-Ms",
        "description": "Define the timeout, in ms"
      },
      "connect.error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "not_found"
            ],
            "enum": [
              "canceled",
              "unknown",
              "invalid_argument",
              "deadline_exceeded",
              "not_found",
              "already_exists",
              "permission_denied",
              "resource_exhausted",
              "failed_precondition",
              "aborted",
              "out_of_range",
              "unimplemented",
              "internal",
              "unavailable",
              "data_loss",
              "unauthenticated"
            ],
            "description": "The status code, which should be an enum value of [google.rpc.Code][google.rpc.Code]."
          },
          "message": {
            "type": "string",
            "description": "A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the [google.rpc.Status.details][google.rpc.Status.details] field, or localized by the client."
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/connect.error_details.Any"
            },
            "description": "A list of messages that carry the error details. There is no limit on the number of messages."
          }
        },
        "title": "Connect Error",
        "additionalProperties": true,
        "description": "Error type returned by Connect: https://connectrpc.com/docs/go/errors/#http-representation"
      },
      "connect.error_details.Any": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URL that acts as a globally unique identifier for the type of the serialized message. For example: `type.googleapis.com/google.rpc.ErrorInfo`. This is used to determine the schema of the data in the `value` field and is the discriminator for the `debug` field."
          },
          "value": {
            "type": "string",
            "format": "binary",
            "description": "The Protobuf message, serialized as bytes and base64-encoded. The specific message type is identified by the `type` field."
          },
          "debug": {
            "oneOf": [
              {
                "type": "object",
                "title": "Any",
                "additionalProperties": true,
                "description": "Detailed error information."
              }
            ],
            "discriminator": {
              "propertyName": "type"
            },
            "title": "Debug",
            "description": "Deserialized error detail payload. The 'type' field indicates the schema. This field is for easier debugging and should not be relied upon for application logic."
          }
        },
        "additionalProperties": true,
        "description": "Contains an arbitrary serialized message along with a @type that describes the type of the serialized message, with an additional debug field for ConnectRPC error details."
      },
      "micropod.v1.ContainerStats": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Container ID."
          },
          "cpuPercent": {
            "type": "number",
            "title": "cpu_percent",
            "format": "double",
            "description": "CPU usage as a percentage of one core."
          },
          "memoryUsedBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "memory_used_bytes",
            "format": "int64",
            "description": "Resident memory in bytes."
          },
          "memoryLimitBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "memory_limit_bytes",
            "format": "int64",
            "description": "Configured memory limit in bytes."
          },
          "networkRxBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "network_rx_bytes",
            "format": "int64",
            "description": "Bytes received over the container network."
          },
          "networkTxBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "network_tx_bytes",
            "format": "int64",
            "description": "Bytes transmitted over the container network."
          },
          "blockReadBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "block_read_bytes",
            "format": "int64",
            "description": "Bytes read from the block device."
          },
          "blockWriteBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "block_write_bytes",
            "format": "int64",
            "description": "Bytes written to the block device."
          },
          "pids": {
            "type": [
              "integer",
              "string"
            ],
            "title": "pids",
            "format": "int64",
            "description": "Number of processes inside the container."
          }
        },
        "title": "ContainerStats",
        "additionalProperties": false,
        "description": "Per-container resource counters within a StatsSnapshot."
      },
      "micropod.v1.DiskCategory": {
        "type": "object",
        "properties": {
          "total": {
            "type": [
              "integer",
              "string"
            ],
            "title": "total",
            "format": "int64",
            "description": "Total objects in the category."
          },
          "active": {
            "type": [
              "integer",
              "string"
            ],
            "title": "active",
            "format": "int64",
            "description": "Objects currently referenced by a running workload."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "On-disk size of the category in bytes."
          },
          "reclaimableBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "reclaimable_bytes",
            "format": "int64",
            "description": "Bytes freed if inactive objects were pruned."
          }
        },
        "title": "DiskCategory",
        "additionalProperties": false
      },
      "micropod.v1.DiskUsage": {
        "type": "object",
        "properties": {
          "containers": {
            "title": "containers",
            "description": "Disk usage attributed to containers.",
            "$ref": "#/components/schemas/micropod.v1.DiskCategory"
          },
          "images": {
            "title": "images",
            "description": "Disk usage attributed to images.",
            "$ref": "#/components/schemas/micropod.v1.DiskCategory"
          },
          "volumes": {
            "title": "volumes",
            "description": "Disk usage attributed to volumes.",
            "$ref": "#/components/schemas/micropod.v1.DiskCategory"
          },
          "totalReclaimableBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "total_reclaimable_bytes",
            "format": "int64",
            "description": "Bytes reclaimable by pruning across all categories."
          }
        },
        "title": "DiskUsage",
        "additionalProperties": false,
        "description": "Disk usage, mapped from `container system df`."
      },
      "micropod.v1.Empty": {
        "type": "object",
        "title": "Empty",
        "additionalProperties": false,
        "description": "The Micropod daemon API is grouped into per-domain services, one per file:\n\n   container.proto \u2014 ContainerService (lifecycle, logs, stats, exec)\n   image.proto     \u2014 ImageService (list, pull, delete)\n   volume.proto    \u2014 VolumeService (volumes + mount policy)\n   network.proto   \u2014 NetworkService\n   compose.proto   \u2014 Compose (up/down over a compose spec)\n   system.proto    \u2014 SystemService (snapshot, usage, app updates)\n\n Empty is shared by every service, so it lives here."
      },
      "micropod.v1.Image": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "title": "id",
            "description": "Image ID (content-addressed digest prefix)."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "names",
            "description": "All tags/references pointing at this image."
          },
          "createdAt": {
            "type": "string",
            "title": "created_at",
            "description": "ISO8601 creation timestamp."
          },
          "digest": {
            "type": "string",
            "title": "digest",
            "description": "Content digest."
          },
          "sizeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "size_bytes",
            "format": "int64",
            "description": "Total unpacked size in bytes."
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ImageVariant"
            },
            "title": "variants",
            "description": "Per-platform variants of this image."
          }
        },
        "title": "Image",
        "additionalProperties": false,
        "description": "Curated view of a local image, mapped from `container image list --verbose`."
      },
      "micropod.v1.ImageVariant": {
        "type": "object",
        "properties": {
          "os": {
            "type": "string",
            "title": "os",
            "description": "Operating system, e.g. \"linux\"."
          },
          "architecture": {
            "type": "string",
            "title": "architecture",
            "description": "CPU architecture, e.g. \"arm64\"."
          },
          "variant": {
            "type": "string",
            "title": "variant",
            "description": "Architecture variant, e.g. \"v8\"."
          }
        },
        "title": "ImageVariant",
        "additionalProperties": false,
        "description": "One platform variant of a multi-arch image."
      },
      "micropod.v1.RegistryLogin": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "title": "server",
            "description": "Registry hostname, e.g. \"docker.io\"."
          },
          "username": {
            "type": "string",
            "title": "username",
            "description": "Account username stored for the registry."
          },
          "scheme": {
            "type": "string",
            "title": "scheme",
            "description": "Auth scheme in use, e.g. \"basic\" or \"oauth\"."
          }
        },
        "title": "RegistryLogin",
        "additionalProperties": false,
        "description": "A registry login, mapped from `container registry list`."
      },
      "micropod.v1.StatsSnapshot": {
        "type": "object",
        "properties": {
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.ContainerStats"
            },
            "title": "containers",
            "description": "Per-container stats, one entry per running container."
          },
          "sampledAt": {
            "type": "string",
            "title": "sampled_at",
            "description": "ISO8601 timestamp the snapshot was taken."
          }
        },
        "title": "StatsSnapshot",
        "additionalProperties": false,
        "description": "Single snapshot of runtime resource usage for all running containers,\n mapped from `container stats --no-stream --format json`."
      },
      "micropod.v1.SystemSnapshot": {
        "type": "object",
        "properties": {
          "status": {
            "title": "status",
            "description": "Runtime health (status, versions, install paths).",
            "$ref": "#/components/schemas/micropod.v1.SystemStatus"
          },
          "diskUsage": {
            "title": "disk_usage",
            "description": "Disk usage grouped by resource kind.",
            "$ref": "#/components/schemas/micropod.v1.DiskUsage"
          }
        },
        "title": "SystemSnapshot",
        "additionalProperties": false
      },
      "micropod.v1.SystemStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "title": "status",
            "description": "\"running\" or \"stopped\"."
          },
          "appRoot": {
            "type": "string",
            "title": "app_root",
            "description": "Path to the installed Micropod.app bundle."
          },
          "installRoot": {
            "type": "string",
            "title": "install_root",
            "description": "Runtime install root (binaries, kernels, images)."
          },
          "apiServerVersion": {
            "type": "string",
            "title": "api_server_version",
            "description": "Version of the embedded API server."
          },
          "cliVersion": {
            "type": "string",
            "title": "cli_version",
            "description": "Version of the bundled `container` CLI."
          }
        },
        "title": "SystemStatus",
        "additionalProperties": false,
        "description": "Runtime health, mapped from `container system status`."
      },
      "micropod.v1.UpdateStatus": {
        "type": "object",
        "properties": {
          "state": {
            "title": "state",
            "description": "Updater lifecycle state.",
            "$ref": "#/components/schemas/micropod.v1.UpdateStatus.State"
          },
          "feedConfigured": {
            "type": "boolean",
            "title": "feed_configured",
            "description": "Whether a Sparkle feed URL is configured."
          },
          "currentVersion": {
            "type": "string",
            "title": "current_version",
            "description": "Currently running app version."
          },
          "availableVersion": {
            "type": "string",
            "title": "available_version",
            "description": "Version available on the feed, if an update was found."
          },
          "downloaded": {
            "type": "boolean",
            "title": "downloaded",
            "description": "True once an update has finished downloading."
          },
          "downloadedVersion": {
            "type": "string",
            "title": "downloaded_version",
            "description": "Version staged for install."
          },
          "readyToInstall": {
            "type": "boolean",
            "title": "ready_to_install",
            "description": "True when ApplyUpdate will succeed immediately."
          },
          "error": {
            "type": "string",
            "title": "error",
            "description": "Last updater error, when `state` is STATE_ERROR."
          },
          "checkedAt": {
            "type": "string",
            "title": "checked_at",
            "description": "ISO8601 time of the last completed check."
          }
        },
        "title": "UpdateStatus",
        "additionalProperties": false,
        "description": "Desktop-app updater status (Sparkle), proxied over the app control\n socket. Reported by CheckForUpdates, GetUpdateStatus, and ApplyUpdate."
      },
      "micropod.v1.UpdateStatus.State": {
        "type": "string",
        "title": "State",
        "enum": [
          "STATE_UNSPECIFIED",
          "STATE_UNAVAILABLE",
          "STATE_IDLE",
          "STATE_CHECKING",
          "STATE_UP_TO_DATE",
          "STATE_UPDATE_AVAILABLE",
          "STATE_INSTALLING",
          "STATE_ERROR"
        ],
        "description": "Updater lifecycle state."
      },
      "micropod.v1.UsageReport": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.UsageReport.ImageUsage"
            },
            "title": "images",
            "description": "Every local image with its referencing containers."
          },
          "volumes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/micropod.v1.UsageReport.VolumeUsage"
            },
            "title": "volumes",
            "description": "Every local volume with its mounting containers."
          },
          "reclaimableImageBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "reclaimable_image_bytes",
            "format": "int64",
            "description": "Bytes reclaimable by pruning unreferenced images."
          },
          "reclaimableVolumeBytes": {
            "type": [
              "integer",
              "string"
            ],
            "title": "reclaimable_volume_bytes",
            "format": "int64",
            "description": "Bytes reclaimable by pruning unmounted volumes."
          },
          "stoppedContainerCount": {
            "type": "integer",
            "title": "stopped_container_count",
            "format": "int32",
            "description": "Number of stopped containers."
          }
        },
        "title": "UsageReport",
        "additionalProperties": false,
        "description": "What a cleanup would reclaim: every image and volume annotated with the\n containers that reference it."
      },
      "micropod.v1.UsageReport.ImageUsage": {
        "type": "object",
        "properties": {
          "image": {
            "title": "image",
            "description": "The image.",
            "$ref": "#/components/schemas/micropod.v1.Image"
          },
          "usedByContainerIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "used_by_container_ids",
            "description": "IDs of containers referencing this image."
          },
          "inUse": {
            "type": "boolean",
            "title": "in_use",
            "description": "True when at least one container references the image."
