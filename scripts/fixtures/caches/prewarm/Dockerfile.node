# T3: an image with a baked npm cache and a corepack-prepared pnpm.
FROM node:26.13.1-alpine
RUN npm install --global corepack@0.36.0 --no-audit --no-fund
COPY npm/a /prewarm/npm
RUN cd /prewarm/npm && npm ci --no-audit --no-fund && \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack prepare pnpm@9.15.9 --activate
