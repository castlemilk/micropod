+// At most one pending direction can own an entire scratch buffer. Closing it,
+// finishing its pending write or revoking its lease returns the loan to this owner.
+static void release_pending(mp_tcp_relay *r, struct endpoint *e) {
+    if (e->pending && e->pending == r->loaned) r->loaned = NULL;
+    else free(e->pending);
+    e->pending = NULL;
+}
+
 static void reap(mp_tcp_relay *r) {
     while (r->retired) {
         struct pair *p = r->retired;
         r->retired = p->next;
-        free(p->client.pending);
-        free(p->guest.pending);
+        release_pending(r, &p->client);
+        release_pending(r, &p->guest);
         free(p);
     }
 }
